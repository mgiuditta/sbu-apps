    "Scegli chi sei" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Who You Are"
          }
        }
      }
    },
    "Scegli il tuo nome: serve a separare i tuoi numeri da quelli degli altri. Sbu Chats lo ricorda per le prossime chat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose your name: it sets your numbers apart from everyone else's. Sbu Chats remembers it for your next chats."
          }
        }
      }
    },
    "Scegli un file" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a File"
          }
        }
