      "comment" : "Why the scan asks for Bluetooth.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sbu Find listens to nearby Bluetooth devices to help you find them. What it hears stays on your iPhone: it is never saved or sent." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Sbu Find ascolta i dispositivi Bluetooth vicini per aiutarti a ritrovarli. Quello che sente resta sull'iPhone: non viene salvato né inviato." } }
