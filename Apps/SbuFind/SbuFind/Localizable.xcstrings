            "state" : "translated",
            "value" : "%lld out of 100"
          }
        }
      }
    },
    "Accendilo dal Centro di Controllo o in Impostazioni, poi torna qui." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn it on in Control Center or in Settings, then come back."
          }
        }
      }
    },
