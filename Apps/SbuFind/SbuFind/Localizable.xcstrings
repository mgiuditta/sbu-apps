    },
    "Cerca di nuovo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search again"
          }
        }
      }
    },
    "Computer portatile" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laptop"
          }
        }
      }
    },
    "Cuffie" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Headphones"
          }
        }
      }
    },
    "Dispositivi senza nome nascosti: %lld. Puoi mostrarli in Impostazioni." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidden devices without a name: %lld. You can show them in Settings."
          }
        }
      }
    },
    "Dispositivo Bluetooth" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth device"
          }
        }
      }
    },
    "Durante la ricerca" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While searching"
          }
        }
      }
    },
    "Freddo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cold"
          }
        }
      }
    },
    "Il Bluetooth per Sbu Find è bloccato da Tempo di utilizzo o da un profilo. Chiedi a chi gestisce questo iPhone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth for Sbu Find is blocked by Screen Time or a profile. Ask whoever manages this iPhone."
          }
        }
      }
    },
    "Impostazioni" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings"
          }
        }
      }
    },
    "Mouse" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouse"
          }
        }
      }
    },
    "Muoviti piano e gira su te stesso: il numero sale quando ti avvicini. Non è una distanza." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move slowly and turn around: the number goes up as you get closer. It is not a distance."
          }
        }
      }
    },
    "Non sentito da %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not heard for %@"
          }
        }
      }
    },
    "Orologio o braccialetto" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch or band"
          }
        }
      }
    },
    "Per sentire i dispositivi vicini, consenti il Bluetooth a Sbu Find in Impostazioni. Quello che sente resta sull'iPhone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To hear nearby devices, allow Bluetooth for Sbu Find in Settings. What it hears stays on your iPhone."
          }
        }
      }
    },
    "Questo dispositivo non ha il Bluetooth Low Energy che serve per sentire i dispositivi vicini." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device lacks the Bluetooth Low Energy needed to hear nearby devices."
          }
        }
      }
    },
    "Qui vicino" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very close"
          }
        }
      }
    },
    "Ricerca in corso" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searching"
          }
        }
      }
    },
    "Sbu Find" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbu Find"
          }
        }
      }
    },
    "Se te lo chiede, consenti il Bluetooth: serve per sentire i dispositivi vicini." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If asked, allow Bluetooth: it is how the app hears nearby devices."
          }
        }
      }
    },
    "Senza nome" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No name"
          }
        }
      }
    },
    "Suono" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sound"
          }
        }
      }
    },
    "Tablet" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tablet"
          }
        }
      }
    },
    "Tastiera" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard"
          }
        }
      }
    },
    "Telefono" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phone"
          }
        }
      }
    },
    "Tieni il dispositivo acceso e fuori dalla custodia: Sbu Find sente solo quello che trasmette." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the device on and out of its case: Sbu Find only hears what is transmitting."
          }
        }
      }
    },
    "Tiepido" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm"
          }
        }
      }
    },
    "Torna da solo tra qualche secondo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It comes back by itself in a few seconds."
          }
        }
      }
    },
    "Un tic che accelera quando ti avvicini, così cerchi senza guardare lo schermo. Il suono segue l'interruttore silenzioso." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tick that speeds up as you get closer, so you can search without looking at the screen. The sound follows the silent switch."
          }
        }
      }
    },
    "Vibrazione" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibration"
          }
        }
      }
    },
    "Vicinanza" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proximity"
          }
        }
      }
    }
  },
  "version" : "1.0"
