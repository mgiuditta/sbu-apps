      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbu Grid.jpg"
          }
        }
      }
    },
    "Scegli la foto da disegnare: Sbu Grid ci stende sopra una griglia, e tu la ricopi sul foglio una cella alla volta." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the photo you want to draw: Sbu Grid lays a grid over it, and you copy it onto paper one cell at a time."
          }
        }
      }
    },
