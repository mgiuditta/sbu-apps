            "value" : "Grid"
          }
        }
      }
    },
    "Il ritaglio ha la forma del foglio: sposta e ridimensiona il riquadro sulla parte da disegnare." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The crop has the sheet's shape: move and resize the frame over the part you want to draw."
          }
        }
      }
    },
    "Impostazioni" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings"
          }
        }
      }
    },
    "La foto non è arrivata. Se è su iCloud, controlla la connessione e riprova." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The photo didn't arrive. If it's in iCloud, check your connection and try again."
