    },
    "Linee" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lines"
          }
        }
      }
    },
    "Metti l'iPhone su un supporto sopra il foglio: vedi la carta con la fotocamera, e la foto con la griglia sopra. Segui le linee con la matita guardando lo schermo. Quello che la fotocamera vede resta sullo schermo: non viene salvato." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put your iPhone on a stand above the sheet: you see the paper through the camera, with the photo and the grid over it. Follow the lines with your pencil while looking at the screen. What the camera sees stays on the screen: it is never saved."
          }
        }
      }
    },
    "Nessuna foto" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No photo"
