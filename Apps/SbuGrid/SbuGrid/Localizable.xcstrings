            "value" : "Dark"
          }
        }
      }
    },
    "Senza colori leggi meglio luci e ombre." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without color, light and shade are easier to read."
          }
        }
      }
    },
    "Senza foglio ritagli la foto come vuoi e scegli righe e colonne in Griglia." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a sheet, you crop the photo as you like and choose rows and columns in Grid."
          }
        }
      }
    },
