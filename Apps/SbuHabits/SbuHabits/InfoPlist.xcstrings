{
  "sourceLanguage" : "it",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "comment" : "The Health read permission prompt. Read only, data stays on the device.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbu Habits reads from Health only the measures you link, to mark your habits. Your data stays on this iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbu Habits legge da Salute solo le misure che colleghi, per segnare le tue abitudini. I dati restano su questo iPhone."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "The Health write permission prompt, required by the App Store with HealthKit. The app never writes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbu Habits never writes to Health. It only reads the measures you link, and your data stays on this iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sbu Habits non scrive niente in Salute. Legge solo le misure che colleghi, e i dati restano su questo iPhone."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
