    "%@: fatta" : {
      "comment" : "A habit is done: its countdown ended, or Salute marked it. The habit's title, then 'done', agreeing with 'abitudine' (feminine).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: done"
          }
        }
      }
    },
    "%@, %@: completamento %@, serie migliore %@, completamenti %@." : {
