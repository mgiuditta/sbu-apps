        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export"
          }
        }
      }
    },
    "Esporta crea un file con le abitudini e lo storico. Lo salvi dove vuoi tu. Importa sostituisce i dati attuali con quelli di un file." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export creates a file with your habits and their history. You save it wherever you want. Import replaces the current data with a file's."
          }
        }
      }
    },
    "Importa" : {
      "comment" : "Settings action and sheet title: replace the data with a file made by Esporta.",
      "localizations" : {
