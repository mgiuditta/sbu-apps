      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not calibrated"
          }
        }
      }
    },
    "Ogni lato si calibra a parte, in due misure. La calibrazione resta su questo iPhone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each side is calibrated on its own, in two readings. The calibration stays on this iPhone."
