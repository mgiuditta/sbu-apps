      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibrate"
          }
        }
      }
    },
    "Calibra un altro lato" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibrate another side"
          }
        }
      }
