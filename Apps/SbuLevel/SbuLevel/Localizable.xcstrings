    "Consenti la fotocamera" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow the camera"
          }
        }
      }
    },
    "Dopo Blocca, la lettura si ferma quando resta entro la tolleranza per due secondi, e mostra la media." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After Lock, the reading stops once it stays within the tolerance for two seconds, and shows the average."
          }
        }
      }
    },
    "Durante la misura" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While measuring"
          }
        }
      }
    },
