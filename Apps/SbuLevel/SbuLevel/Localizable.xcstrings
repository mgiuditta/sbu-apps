            "value" : "Unit"
          }
        }
      }
    },
    "x:12 è l'alzata su 12 di base, come si legge un tetto. 1V:H è la base per 1 di alzata. Il quadrante resta in gradi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x:12 is the rise on a run of 12, as a roof is read. 1V:H is the run for a rise of 1. The dial stays in degrees."
          }
        }
      }
    }
