{
  "sourceLanguage" : "it",
  "strings" : {
    "Annulla" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel"
          }
        }
      }
    },
    "Appoggia l'iPhone sul lato da calibrare e tocca Misura. Non serve una superficie in bolla." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place your iPhone on the side to calibrate and tap Measure. The surface doesn't need to be level."
          }
        }
      }
    },
    "Appoggia l'iPhone sullo stesso lato della prima misura." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place your iPhone on the same side as the first reading."
          }
        }
      }
    },
    "Blocca" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock"
          }
        }
      }
    },
