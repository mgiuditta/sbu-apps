    "Linea di mira" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Line of sight"
          }
        }
      }
    },
    "Lo schermo non si spegne mentre l'app è aperta." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The screen stays on while the app is open."
          }
        }
      }
    },
    "Mai" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never"
          }
        }
      }
    },
