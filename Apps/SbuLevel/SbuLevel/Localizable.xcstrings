      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sight"
          }
        }
      }
    },
    "Misura" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measure"
          }
        }
      }
    },
    "Misura in corso: tieni fermo l'iPhone" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measuring: keep your iPhone still"
          }
        }
      }
    },
    "Misurare" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measuring"
          }
        }
      }
    },
    "Modalità" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modes"
          }
        }
      }
    },
    "Mostra i controlli" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show controls"
          }
        }
      }
    },
    "Non calibrato" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not calibrated"
          }
        }
      }
    },
    "Ogni 3 secondi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every 3 seconds"
          }
        }
      }
    },
    "Ogni lato si calibra a parte, in due misure. La calibrazione resta su questo iPhone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each side is calibrated on its own, in two readings. The calibration stays on this iPhone."
          }
        }
      }
    },
    "Ogni lato si calibra a parte: misura, gira l'iPhone di 180° sullo stesso punto e misura ancora. Le due misure si compensano, quindi la superficie non deve essere in bolla." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each side is calibrated on its own: measure, turn your iPhone 180° on the same spot and measure again. The two readings cancel out, so the surface doesn't need to be level."
          }
        }
      }
    },
    "Passo 1 di 2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Step 1 of 2"
          }
        }
      }
    },
    "Passo 2 di 2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Step 2 of 2"
          }
        }
      }
    },
    "Pendenza in %" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slope in %"
          }
        }
      }
    },
    "Piano" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat"
          }
        }
      }
    },
    "Precisione" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accuracy"
          }
        }
      }
    },
    "Prende la posizione attuale come zero: la cifra mostra di quanto ti sposti da lì. Assoluto torna all'angolo vero." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takes the current position as zero: the figure shows how far you move from there. Absolute goes back to the true angle."
          }
        }
      }
    },
    "Quadrante" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dial"
          }
        }
      }
    },
    "Quando si ferma" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When it settles"
          }
        }
      }
    },
    "Quanta base per 1 di alzata, come si scrive una scarpata." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much run for 1 of rise, as an embankment is written."
          }
        }
      }
    },
    "Quanto sale ogni 100 di base: 100 % è 45°. A 90° non ha valore e la cifra mostra un trattino." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much it rises for every 100 of run: 100 % is 45°. At 90° it has no value and the figure shows a dash."
          }
        }
      }
    },
    "Quanto sale ogni 12 di base, come si misura un tetto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much it rises for every 12 of run, as a roof is measured."
          }
        }
      }
    },
    "Rapporto 1V:H" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratio 1V:H"
          }
        }
      }
    },
    "Relativo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relative"
          }
        }
      }
    },
    "Relativo, allo zero" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relative, at zero"
          }
        }
      }
    },
    "Ripristina calibrazione" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset calibration"
          }
        }
      }
    },
    "Risultato" : {
      "localizations" : {
        "en" : {
