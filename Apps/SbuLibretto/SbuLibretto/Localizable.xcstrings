        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cum laude"
          }
        }
      }
    },
    "Lode 30, conversione × 110/30, bonus pari ai punti della commissione, arrotondamento all'intero." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cum laude 30, conversion × 110/30, bonus equal to the committee's points, rounding to the whole number."
          }
        }
      }
