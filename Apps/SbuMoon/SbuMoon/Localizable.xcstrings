    "Impostato" : {
      "comment" : "The Closure word when a phase alert is turned on and iOS will deliver it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set"
          }
        }
      }
    },
    "La posizione è disattivata per Sbu Moon. Attivala nelle Impostazioni dell'iPhone, o scegli una città." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location is off for Sbu Moon. Turn it on in the iPhone's Settings, or choose a city."
          }
        }
      }
    },
    "La tua posizione" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location"
          }
        }
      }
    },
    "Le notifiche di Sbu Moon sono disattivate: gli avvisi non arrivano. Attivale nelle Impostazioni dell'iPhone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications for Sbu Moon are off, so alerts won't arrive. Turn them on in the iPhone's Settings."
          }
        }
      }
    },
    "Letta una volta, con la precisione di un chilometro. Resta su questo iPhone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read once, accurate to about a kilometer. It stays on this iPhone."
          }
        }
      }
    },
    "Luna" : {
      "comment" : "The app in the tool screen cartiglio: Sbu · Luna · day · place.",
