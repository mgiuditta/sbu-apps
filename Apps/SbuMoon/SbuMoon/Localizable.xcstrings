          }
        }
      }
    },
    "Fasi, sorgere e tramonto calcolati su questo iPhone con gli algoritmi di Jean Meeus, senza rete. Gli orari hanno un errore di qualche minuto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phases, moonrise and moonset worked out on this iPhone with Jean Meeus's algorithms, without network. Times can be off by a few minutes."
          }
        }
      }
    },
    "Fine" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
