      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show moonrise and moonset"
          }
        }
      }
    },
    "Nessuna città trovata per «%@»." : {
      "comment" : "The place search found no city; %@ is what the person typed.",
