        }
      }
    },
    "Non funziona con Fire TV, Hisense VIDAA, Philips senza Android, Roku e Apple TV: per Apple TV usa il telecomando nel Centro di Controllo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does not work with Fire TV, Hisense VIDAA, Philips without Android, Roku and Apple TV: for Apple TV, use the remote in Control Center."
          }
        }
      }
    },
