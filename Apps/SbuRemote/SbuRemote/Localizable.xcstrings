        }
      }
    },
    "Funziona con Samsung Tizen dal 2016, LG webOS, Android TV e Google TV (Sony, TCL, Philips, Xiaomi, Hisense, Chromecast) e Sony Bravia." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Works with Samsung Tizen from 2016, LG webOS, Android TV and Google TV (Sony, TCL, Philips, Xiaomi, Hisense, Chromecast) and Sony Bravia."
          }
        }
      }
    },
    "Indirizzo IP, per esempio 192.168.1.20" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IP address, for example 192.168.1.20"
