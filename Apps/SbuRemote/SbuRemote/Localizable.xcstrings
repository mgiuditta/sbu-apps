  "strings" : {
    "Accendi la TV e collega il telefono alla stessa Wi-Fi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on the TV and connect your phone to the same Wi-Fi."
          }
        }
      }
    },
    "Accendi la TV e collega il telefono alla stessa Wi-Fi. Sbu Remote la cerca e la comanda da qui." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on the TV and connect your phone to the same Wi-Fi. Sbu Remote finds it and controls it from here."
          }
        }
      }
    },
