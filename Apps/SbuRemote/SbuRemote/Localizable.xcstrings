    },
    "Questa TV parla senza cifratura sulla rete di casa: chi usa la stessa Wi-Fi può leggere i comandi che le mandi. Succede con i modelli meno recenti." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This TV talks without encryption on your home network: anyone on the same Wi-Fi can read the commands you send it. Older models do this."
          }
        }
      }
    },
