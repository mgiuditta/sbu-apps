# Lanes for Sbu Scanner. Run from Apps/SbuScanner.
# beta/release need an App Store Connect API key in the environment:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to the .p8), SBU_TEAM_ID
default_platform(:ios)

platform :ios do
  before_all do
    Dir.chdir("..") { sh("xcodegen", "generate") }
  end

  desc "Unit tests on the simulator"
  lane :test do
    run_tests(scheme: "SbuScanner", devices: ["iPhone 17"])
  end

  desc "App Store screenshots (Snapfile), Italian and English"
  lane :snapshot do
    capture_screenshots
  end

  desc "Panorama on paper with the icon engraving and a closing card with the logo (Tools/make_screenshots.py)"
  lane :frames do
    sh("python3", File.expand_path("../../../Tools/make_screenshots.py", __dir__), "scanner")
  end

  # The App Store Connect API can't create apps, so this lane logs in with the Apple ID in
  # FASTLANE_USER: 2FA the first time, then the session cached in ~/.fastlane/spaceship.
  desc "Register the bundle ID and create the App Store Connect record, Italian primary language"
  lane :create_app do
    produce(
      username: ENV.fetch("FASTLANE_USER"),
      app_name: "Sbu Scanner",
      language: "Italian",
      sku: "dev.sbu.scanner",
      platform: "ios"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key
    increment_build_number(build_number: latest_testflight_build_number + 1, xcodeproj: "SbuScanner.xcodeproj")
    build_app(scheme: "SbuScanner", export_method: "app-store", xcargs: signing_args)
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build and upload to the App Store with metadata and framed screenshots, without submitting"
  lane :release do
    api_key
    build_app(scheme: "SbuScanner", export_method: "app-store", xcargs: signing_args)
    upload_to_app_store(
      submit_for_review: false,
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload only metadata and framed screenshots to the App Store listing, without a build or submitting"
  lane :metadata do
    api_key
    version = ensure_app_store_version
    ensure_review_detail
    upload_to_app_store(
      app_version: version,
      skip_binary_upload: true,
      submit_for_review: false,
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Print the App Store versions and the latest builds"
  lane :state do
    api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    app.get_app_store_versions.each { |v| UI.message("version #{v.version_string} #{v.app_store_state}") }
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 5).each do |b|
      UI.message("build #{b.app_version} (#{b.version}) #{b.processing_state}")
    end
    version = app.get_edit_app_store_version or next
    UI.message("editing #{version.version_string}, build #{version.build&.version || "none"}")
    version.get_app_store_version_localizations.each do |localization|
      shots = localization.get_app_screenshot_sets.sum { |set| set.app_screenshots.count }
      UI.message("#{localization.locale}: #{shots} screenshots, notes #{localization.whats_new.to_s.length} chars, description #{localization.description.to_s.length} chars")
    end
  end

  desc "Attach an uploaded build to the version being edited, without submitting: fastlane select_build build:4"
  lane :select_build do |options|
    api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = app.get_edit_app_store_version || UI.user_error!("No App Store version being edited: run the metadata lane first")
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version.version_string, build_number: options[:build].to_s).first
    UI.user_error!("No build #{options[:build]} for #{version.version_string}") unless build
    UI.user_error!("Build #{options[:build]} is #{build.processing_state}") unless build.processing_state == "VALID"
    version.select_build(build_id: build.id)
    UI.success("#{version.version_string} uses build #{build.version}")
  end

  # Automatic signing creates the App Store profiles (app and widget, with the App Group) itself.
  def signing_args
    "-allowProvisioningUpdates -authenticationKeyPath #{ENV.fetch("ASC_KEY_PATH")} " \
      "-authenticationKeyID #{ENV.fetch("ASC_KEY_ID")} -authenticationKeyIssuerID #{ENV.fetch("ASC_ISSUER_ID")}"
  end

  # The version in project.yml, created on App Store Connect if the live one is older (a 2.0 over a 1.0).
  private_lane :ensure_app_store_version do
    version = get_version_number(xcodeproj: "SbuScanner.xcodeproj", target: "SbuScanner")
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    app.ensure_version!(version, platform: Spaceship::ConnectAPI::Platform::IOS)
    version
  end

  # A first version has no App Review details yet, and deliver fails reading them ("No data",
  # fastlane#20538): create the empty record first.
  private_lane :ensure_review_detail do
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    version = app.get_edit_app_store_version
    begin
      version.fetch_app_store_review_detail
    rescue StandardError
      notes = File.read(File.expand_path("metadata/review_information/notes.txt", __dir__)).strip
      version.create_app_store_review_detail(attributes: { notes: notes })
    end
  end

  private_lane :api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end
end
