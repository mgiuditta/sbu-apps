      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame rate"
          }
        }
      }
    },
    "Frame rate 24, dimensioni 80%, qualità 60%, Avanzate spente.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frame rate 24, dimensions 80%, quality 60%, Advanced off."
          }
        }
      }
    },
    "Già leggeri, restano come sono: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already light, kept as they are: %lld"
          }
        }
      }
    },
    "Già leggero, resta com'è": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already light, kept as is"
          }
        }
      }
    },
    "H.264": {
      "shouldTranslate": false
    },
    "H.264 si apre ovunque. HEVC pesa circa un terzo in meno, ma alcuni computer e siti non lo leggono.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 opens everywhere. HEVC is about a third smaller, but some computers and websites cannot read it."
          }
        }
      }
    },
    "HEVC": {
      "shouldTranslate": false
    },
    "I video ci stanno già alla qualità piena: verranno più leggeri del limite.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The videos already fit at full quality: they will come out lighter than the limit."
          }
        }
      }
    },
    "Importa da File": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import from Files"
          }
        }
      }
    },
    "In attesa": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting"
          }
        }
      }
    },
    "Interrompere la compressione? I video già compressi restano in Foto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop compressing? Videos already compressed stay in Photos."
          }
        }
      }
    },
