      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore suggested settings"
          }
        }
      }
    },
    "Ripristinare le impostazioni consigliate?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
