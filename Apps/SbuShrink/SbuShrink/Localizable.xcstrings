    "Interrotto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped"
          }
        }
      }
    },
    "Le copie vanno sempre nella libreria di Foto, con la data e il luogo dell'originale.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies always go to the Photos library, with the date and place of the original."
          }
        }
      }
    },
    "Lettura dei video in corso": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the videos"
          }
        }
      }
    },
    "MB per video": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MB per video"
          }
        }
      }
    },
    "MP4 si carica ovunque; senza conversione il video resta nel formato dell'iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MP4 uploads anywhere; without converting, the video keeps the iPhone's format."
          }
        }
      }
    },
    "Max %@ MB": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max %@ MB"
          }
        }
      }
    },
    "Nessun video è diventato più leggero": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No video got lighter"
          }
        }
      }
    },
    "Non compressi: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not compressed: %lld"
          }
        }
      }
    },
    "Non compresso": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not compressed"
          }
        }
      }
    },
    "Non leggibili, restano fuori: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreadable, left out: %lld"
          }
        }
      }
    },
    "Ogni video viene compresso per pesare al massimo questi MB, e la qualità si regola da sola.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each video is compressed to weigh at most this many MB, and quality sets itself."
          }
        }
      }
    },
    "Ogni video viene compresso per pesare al massimo questi MB.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each video is compressed to weigh at most this many MB."
          }
        }
      }
    },
    "Ora %@, %@ in meno": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now %@, %@ smaller"
          }
        }
      }
    },
    "Originali eliminati: %lld. Restano in Eliminati di recente per 30 giorni.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Originals deleted: %lld. They stay in Recently Deleted for 30 days."
          }
        }
      }
    },
    "Per alcuni video non basta: verranno più pesanti. Riduci le dimensioni o togli l'audio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough for some videos: they will come out heavier. Lower the dimensions or remove the audio."
          }
        }
      }
    },
    "Più fotogrammi al secondo occupano più spazio. Ti consigliamo di non scendere sotto 24. Mai oltre quelli del video.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More frames per second take more space. We suggest not going under 24. Never more than the video has."
          }
        }
      }
    },
    "Più qualità tiene più dettagli e occupa più spazio. Ti consigliamo il 60%.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher quality keeps more detail and takes more space. We suggest 60%."
          }
        }
      }
    },
    "Prima": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before"
          }
        }
      }
    },
    "Qualità": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quality"
          }
        }
      }
    },
    "Riduci le dimensioni del video per risparmiare ancora più spazio. Ti consigliamo l'80%.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce the dimensions of the video to save even more space. We suggest 80%."
          }
        }
      }
    },
    "Ripristina": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        }
      }
    },
