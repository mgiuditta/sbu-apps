    "Sbu Shrink": {
      "shouldTranslate": false
    },
    "Scegli da Foto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from Photos"
          }
        }
      }
    },
    "Scegli uno o più video: diventano più leggeri e liberi spazio sull'iPhone. Tutto resta sul telefono.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one or more videos: they get lighter and free up space on your iPhone. Everything stays on the phone."
          }
        }
      }
    },
    "Ti consigliamo di non scendere sotto 24.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We suggest not going under 24."
          }
        }
      }
    },
    "Ti consigliamo l'80%.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We suggest 80%."
          }
        }
      }
