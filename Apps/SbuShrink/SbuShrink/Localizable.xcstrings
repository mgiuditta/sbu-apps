    "Foto non consentito: le copie non sono in Foto. Condividile, o consenti l'accesso.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos not allowed: the copies are not in Photos. Share them, or allow access."
          }
        }
      }
    },
    "Foto non ha eliminato gli originali.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos did not delete the originals."
          }
        }
      }
    },
