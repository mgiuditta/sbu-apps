            "value": "Grid"
          }
        }
      }
    },
    "Il record resta solo su questo iPhone. Niente classifiche, niente account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your best stays on this iPhone only. No leaderboards, no account."
          }
        }
      }
    },
    "Iniziare una nuova partita?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new game?"
          }
        }
      }
    },
    "Libera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free"
          }
        }
      }
    },
    "Mette qui l'angolo in alto a sinistra del pezzo scelto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts the top-left corner of the chosen piece here."
          }
        }
      }
    },
    "Nessun pezzo entra più, e hai battuto il record.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No piece fits any more, and you beat your best."
          }
        }
      }
    },
    "Nessun pezzo entra più.": {
      "localizations": {
