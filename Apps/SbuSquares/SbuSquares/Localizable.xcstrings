    "Partita del giorno finita, con il record. Domani ne hai un'altra, uguale per tutti.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily game over, with a new best. Tomorrow there's another, the same for everyone."
          }
        }
      }
    },
    "Partita del giorno finita. Domani ne hai un'altra, uguale per tutti.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
