{
  "sourceLanguage": "it",
  "strings": {
    "%@ · combo %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · combo %2$lld"
          }
        }
      }
    },
    "Annulla": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "Annulla l'ultima mossa": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo last move"
          }
        }
      }
    },
    "Azzera il record": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset best"
          }
        }
      }
    },
    "Azzerare il record?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset your best?"
          }
        }
      }
    },
    "Battuto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaten"
          }
        }
      }
    },
    "Gioca ancora": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play again"
          }
        }
      }
    },
    "Griglia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grid"
          }
        }
      }
    },
    "Il record resta solo su questo iPhone. Niente classifiche, niente account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your best stays on this iPhone only. No leaderboards, no account."
          }
        }
      }
    },
    "Iniziare una nuova partita?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new game?"
          }
        }
      }
    },
    "Mette qui l'angolo in alto a sinistra del pezzo scelto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts the top-left corner of the chosen piece here."
          }
        }
      }
    },
    "Nessun pezzo entra più, e hai battuto il record.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No piece fits any more, and you beat your best."
          }
        }
      }
    },
    "Nessun pezzo entra più.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No piece fits any more."
          }
        }
      }
    },
    "Nessun pezzo entra più. Puoi annullare l'ultima mossa, una volta a partita.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No piece fits anymore. You can undo your last move, once a game."
          }
        }
      }
    },
    "Nuova partita": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New game"
          }
        }
      }
    },
    "Pezzo da %lld quadretti, %lld per %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Piece of %1$lld squares, %2$lld by %3$lld"
          }
        }
      }
    },
    "Piena": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filled"
          }
        }
      }
    },
    "Più %lld punti": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus %lld points"
          }
        }
      }
    },
    "Più %lld punti, combo %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus %1$lld points, combo %2$lld"
          }
        }
      }
    },
    "Posto vuoto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty place"
          }
        }
      }
    },
    "Punteggio %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Score %lld"
          }
        }
      }
