scheme("SbuTidySnapshots")
project("./SbuTidy.xcodeproj")
# iPad too: the app runs on iPad, and App Store Connect wants its 13-inch screenshots.
devices(["iPhone 17 Pro Max", "iPad Pro 13-inch (M5)"])
languages(["it", "en-US"])
output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)
override_status_bar(true)
only_testing(["SbuTidyUITests/SnapshotTests"])
