---
// One App Sbu in the home list: icon, name, Cosa sola. A row of an inset grouped list.
import { capitalize, localePath, ui, type Locale } from '../i18n';
import { text, type App } from '../lib/apps';

interface Props {
  app: App;
  locale: Locale;
}
const { app, locale } = Astro.props;
const listing = text(app, locale);
---
<a href={localePath(locale, `apps/${app.slug}`)} class="flex items-center gap-4 px-4 py-3 text-ink no-underline hover:bg-surface-sunken">
  <img src={app.icon} alt="" width="48" height="48" class="size-12 shrink-0" />
  <span class="flex grow flex-col">
    <span class="text-headline">{listing.name}</span>
    <span class="text-subheadline text-ink-muted">{capitalize(listing.oneThing)}.</span>
    {app.status !== 'live' && <span class="text-caption uppercase text-ink-muted">{ui[locale].comingSoon}</span>}
  </span>
  <span aria-hidden="true" class="text-ink-muted">›</span>
</a>
