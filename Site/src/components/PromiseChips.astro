---
// The promises as pills, words only: the full stop is the page's one geometric mark.
interface Props {
  promises: readonly string[];
  label: string;
}
const { promises, label } = Astro.props;
---
<ul aria-label={label} class="flex flex-wrap gap-2">
  {promises.map((promise) => (
    <li class="rounded-pill bg-surface-raised px-3 py-1 text-footnote font-[var(--text-caption--font-weight)] text-ink">
      {promise}
    </li>
  ))}
</ul>
