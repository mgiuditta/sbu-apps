---
// A still of the Schermata strumento, like SbuToolField: the Cifra on `surface`, no colored field, no card.
import Stat from './Stat.astro';
import { ui, type Locale } from '../i18n';
import { text, type App } from '../lib/apps';

interface Props {
  app: App;
  locale: Locale;
}
const { app, locale } = Astro.props;
const figure = app.figure?.[locale];
---
{figure && (
  <figure class="flex flex-col gap-4 border-y border-line py-12">
    <Stat value={figure.value} label={figure.label} />
    <figcaption class="text-footnote text-ink-muted">{ui[locale].shotCaption(text(app, locale).name)}</figcaption>
  </figure>
)}
