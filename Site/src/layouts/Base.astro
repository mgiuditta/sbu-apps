---
import '../styles/global.css';
import mark from '../../../Design/logos/sbu-mark.svg?url';
import logoSvg from '../../../Design/logos/sbu-logo.svg?raw';
import { localePath, ui, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Locale-neutral path: '' or 'apps/level'. */
  path: string;
  alternates: Locale[];
  title: string;
  description: string;
  jsonLd?: object[];
  image?: string;
  noindex?: boolean;
  /** `stage`: the home. The header floats over a full-screen main, which brings its own width. */
  layout?: 'page' | 'stage';
}

const { locale, path, alternates, title, description, jsonLd = [], image, noindex = false, layout = 'page' } = Astro.props;
const stage = layout === 'stage';
const t = ui[locale];
const site = Astro.site!;
const absolute = (target: Locale) => new URL(localePath(target, path), site).href;
const other = t.otherLocale.lang as Locale;
const ogLocale = { it: 'it_IT', en: 'en_US' };
// The logo as drawn, its warm black swapped for currentColor so it follows `brand` in dark mode.
const logo = logoSvg
  .replaceAll('fill="#0A0A00"', 'fill="currentColor"')
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" class="block h-5 w-auto" ');
const nav = [
  { href: localePath(locale, ''), label: t.nav.apps },
  { href: localePath(locale, 'principi'), label: t.nav.principles },
  { href: localePath(locale, 'support'), label: t.nav.support },
];
const footer = [
  { href: localePath(locale, 'principi'), label: t.nav.principles },
  { href: localePath(locale, 'support'), label: t.nav.support },
  { href: localePath(locale, 'privacy'), label: t.nav.privacy },
  { href: localePath(locale, 'blog'), label: t.nav.blog },
  { href: localePath(locale, 'livella'), label: t.nav.levelTool },
  { href: localePath(locale, 'abbonamenti'), label: t.nav.subscriptionCost },
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={stage ? 'width=device-width, initial-scale=1, viewport-fit=cover' : 'width=device-width, initial-scale=1'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={absolute(locale)} />}
    {!noindex && alternates.map((alt) => <link rel="alternate" hreflang={alt} href={absolute(alt)} />)}
    {!noindex && alternates.includes('it') && <link rel="alternate" hreflang="x-default" href={absolute('it')} />}
    <link rel="icon" href={mark} type="image/svg+xml" />
    {/* public/apple-touch-icon.png: Design/logos/sbu-mark.svg at 180px, square corners (iOS rounds them). */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sbu.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(locale)} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {alternates.filter((alt) => alt !== locale).map((alt) => <meta property="og:locale:alternate" content={ogLocale[alt]} />)}
    {image && <meta property="og:image" content={new URL(image, site).href} />}
    <meta name="twitter:card" content="summary" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="min-h-dvh bg-surface text-ink">
    <a href="#main" class="sr-only focus:not-sr-only">{t.skip}</a>
    <header
      class:list={[
        'flex flex-wrap items-center justify-between gap-4',
        stage ? 'stage-bar' : 'page py-4',
      ]}
    >
      <a href={localePath(locale, '')} class="py-2 text-brand">
        <Fragment set:html={logo} />
        <span class="sr-only">sbu.dev</span>
      </a>
      <nav aria-label={t.navLabel}>
        <ul class="flex flex-wrap items-center gap-4 text-subheadline">
          {nav.map((item) => <li><a href={item.href} class:list={['no-underline hover:underline', stage ? 'text-ink-muted hover:text-ink' : 'text-ink']}>{item.label}</a></li>)}
          {alternates.includes(other) && (
            <li><a href={localePath(other, path)} hreflang={other} lang={other} class="text-ink-muted">{t.otherLocale.label}</a></li>
          )}
          <slot name="nav-end" />
        </ul>
      </nav>
    </header>
    <main id="main" class:list={[!stage && 'page pb-12']}>
      <slot />
    </main>
    <footer class="border-t border-line">
      {/* text-footnote on the children, not here: on .page it would shrink the 70ch column. */}
      <div class="page flex flex-col gap-2 py-8 text-ink-muted">
        <ul class="flex flex-wrap gap-4 text-footnote">
          {footer.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
        <p class="text-footnote">{t.footerNote}</p>
      </div>
    </footer>
  </body>
</html>
