---
import '../styles/global.css';
import mark from '../../../Design/logos/sbu-mark.svg?url';
import logoSvg from '../../../Design/logos/sbu-logo.svg?raw';
import { localePath, ui, type Locale } from '../i18n';
import { allEngravings, getApps, text } from '../lib/apps';
import { REPO_URL, SOCIAL } from '../lib/pages';
import GitHubMark from '../components/GitHubMark.astro';

interface Props {
  locale: Locale;
  /** Locale-neutral path: '' or 'apps/habits'. */
  path: string;
  alternates: Locale[];
  title: string;
  description: string;
  jsonLd?: object[];
  /** Link preview, 1200x630 from Tools/make_og.py. Defaults to the home's. */
  image?: string;
  noindex?: boolean;
  /** `wide`: the home, whose content fills the frame. Otherwise the reading column, with the plate beside it. */
  layout?: 'page' | 'wide';
  /** The plate beside the column: the app page passes its own engraving, or `false` without one; by default one is picked by the path. */
  plate?: { src: string; caption?: string; lead?: boolean } | false;
  /** A live app's App Store id: Safari on iPhone shows its Smart App Banner. */
  appStoreId?: number;
}

const { locale, path, alternates, title, description, jsonLd = [], image = `/og/home-${locale}.png`, noindex = false, layout = 'page', appStoreId } = Astro.props;
const wide = layout === 'wide';
const t = ui[locale];
const site = Astro.site!;
const absolute = (target: Locale) => new URL(localePath(target, path), site).href;
const other = t.otherLocale.lang as Locale;
const ogLocale = { it: 'it_IT', en: 'en_US' };
// The logo as drawn, its warm black swapped for currentColor so it follows `brand` in dark mode.
const logo = logoSvg
  .replaceAll('fill="#0A0A00"', 'fill="currentColor"')
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" class="block h-5 w-auto" ');
const nav = [
  { href: localePath(locale, ''), label: t.nav.apps },
  { href: localePath(locale, 'games'), label: t.nav.games },
  { href: localePath(locale, 'software'), label: t.nav.software },
  { href: localePath(locale, 'principi'), label: t.nav.principles },
];
const footer = [
  { href: localePath(locale, 'principi'), label: t.nav.principles },
  { href: localePath(locale, 'support'), label: t.nav.support },
  { href: localePath(locale, 'privacy'), label: t.nav.privacy },
  { href: localePath(locale, 'blog'), label: t.nav.blog },
  { href: localePath(locale, 'stampa'), label: t.nav.press },
  { href: localePath(locale, 'alternatives'), label: t.nav.alternatives },
  { href: localePath(locale, 'abbonamenti'), label: t.nav.subscriptionCost },
  { href: localePath(locale, 'qr-code'), label: t.nav.qrCode },
];
// The footer keeps the free tools apart from the pages about Sbu.
const tools = new Set([localePath(locale, 'abbonamenti'), localePath(locale, 'qr-code')]);
const here = localePath(locale, path);
// The header marks the section you are in: the page itself, or a page under it (app pages sit under App).
const section = (href: string) => {
  if (href === here) return 'page';
  const top = href === localePath(locale, '') ? localePath(locale, 'apps') : href;
  return here.startsWith(`${top}/`) ? 'true' : undefined;
};
// The sheet lists the header's links first, then the footer's others.
const more = footer.filter((item) => !nav.some((top) => top.href === item.href));
// The apps you can download, then the whole catalogue on the home.
const footerApps = [
  ...(await getApps()).filter((app) => app.status === 'live').map((app) => ({ href: localePath(locale, `apps/${app.slug}`), label: text(app, locale).name })),
  { href: localePath(locale, ''), label: t.footerAllApps },
];
// One instrument per page, the same on every visit: picked by the path, not at random.
const engravings = await allEngravings(800, locale);
const picked = engravings[[...path].reduce((sum, c) => sum + c.charCodeAt(0), 0) % engravings.length];
const plate = !wide && (Astro.props.plate ?? { src: picked.src, caption: picked.caption });
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Classic and blocking: pagereveal fires before the first frame, and the CSP allows no inline script. */}
    <script is:inline src="/flight.js"></script>
    <title>{title}</title>
    {/* Every page opens on a Bricolage title: fetched with the HTML, so the title is not drawn twice. */}
    <link rel="preload" href="/fonts/BricolageGrotesque-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {appStoreId && <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={absolute(locale)} />}
    {!noindex && alternates.map((alt) => <link rel="alternate" hreflang={alt} href={absolute(alt)} />)}
    {!noindex && alternates.includes('it') && <link rel="alternate" hreflang="x-default" href={absolute('it')} />}
    <link rel="icon" href={mark} type="image/svg+xml" />
    {/* public/apple-touch-icon.png: Design/logos/sbu-mark.svg at 180px, square corners (iOS rounds them). */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={t.feedTitle} href={new URL(localePath(locale, 'rss.xml'), site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sbu.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(locale)} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {alternates.filter((alt) => alt !== locale).map((alt) => <meta property="og:locale:alternate" content={ogLocale[alt]} />)}
    <meta property="og:image" content={new URL(image, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  {/* No background here: html carries the paper, so the backdrop at z-index -1 sits on it, under the page. */}
  <body class="min-h-dvh text-ink">
    <a href="#main" class="sr-only focus:not-sr-only">{t.skip}</a>
    <header class="bar">
      <div class="frame flex items-center justify-between gap-4">
        <a href={localePath(locale, '')} class="py-2 text-brand">
          <Fragment set:html={logo} />
          <span class="sr-only">sbu.dev</span>
        </a>
        <div class="flex items-center gap-4 text-subheadline">
          <nav aria-label={t.navLabel} class="wide">
            <ul class="flex items-center gap-4">
              {nav.map((item) => (
                <li>
                  {/* The label rolls up letter by letter on hover; screen readers get it whole. */}
                  <a href={item.href} class="roll py-3 text-ink" aria-current={section(item.href)}>
                    <span class="sr-only">{item.label}</span>
                    <span aria-hidden="true">{[...item.label].map((c, i) => <span style={`--i: ${i}`} data-c={c}>{c}</span>)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          {/* The language is not a section: it stands apart, muted, before the code. */}
          {alternates.includes(other) && (
            <a href={localePath(other, path)} hreflang={other} lang={other} class="wide py-3 text-ink-muted no-underline hover:underline">{t.otherLocale.label}</a>
          )}
          <a href={REPO_URL} class="-m-2 p-2 text-ink hover:text-ink-muted" title={t.code}>
            <GitHubMark />
            <span class="sr-only">{t.code}</span>
          </a>
          <button type="button" class="narrow py-3 text-ink" data-menu-open aria-haspopup="dialog">{t.menu}</button>
        </div>
      </div>
    </header>
    {/* The phone's menu: one sheet of paper over the page, its links set large and printed in one by one. */}
    <dialog class="sheet" data-menu aria-label={t.navLabel}>
      {plate && <div class="sheet-engraving" style={`--engraving: url(${plate.src})`} aria-hidden="true"></div>}
      <div class="flex items-center justify-between gap-4 py-4">
        <span class="py-2 text-brand"><Fragment set:html={logo} /></span>
        <button type="button" class="text-subheadline text-ink" data-menu-close>{t.close}</button>
      </div>
      <nav aria-label={t.navLabel}>
        <ul class="flex flex-col gap-2">
          {nav.map((item, i) => (
            <li style={`--i: ${i}`}><a href={item.href} class="sheet-link" aria-current={item.href === here ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
        <ul class="mt-8 flex flex-col gap-3 text-body">
          {more.map((item, i) => (
            <li style={`--i: ${nav.length + i}`}><a href={item.href} class="text-ink-muted" aria-current={item.href === here ? 'page' : undefined}>{item.label}</a></li>
          ))}
          {alternates.includes(other) && (
            <li style={`--i: ${nav.length + more.length}`}><a href={localePath(other, path)} hreflang={other} lang={other} class="text-ink-muted">{t.otherLocale.label}</a></li>
          )}
          <li style={`--i: ${nav.length + more.length + 1}`}><a href={REPO_URL} class="inline-flex items-center gap-2 text-ink-muted"><GitHubMark class="h-4 w-4" />{t.code}</a></li>
        </ul>
      </nav>
    </dialog>
    <script>
      // A native modal dialog: Esc, focus trap and the page made inert come with it.
      const sheet = document.querySelector<HTMLDialogElement>('[data-menu]')!;
      document.querySelector('[data-menu-open]')!.addEventListener('click', () => sheet.showModal());
      document.querySelector('[data-menu-close]')!.addEventListener('click', () => sheet.close());
    </script>
    {/* Header, main and footer share the frame, so the logo never moves from page to page. The reading
        column sits under the logo; the plate, the one perfect drawing on the page, stands still beside it. */}
    <main id="main" class="frame pb-[calc(var(--sbu-grid-cell)*2)]">
      {wide ? <slot /> : (
        <div class="reading">
          <div class="column"><slot /></div>
          {plate && (
            <figure class:list={['plate', { 'plate-lead': plate.lead }]}>
              <div class="plate-art" style={`--engraving: url(${plate.src})`} aria-hidden="true"></div>
              {plate.caption && <figcaption class="text-footnote text-ink-muted">{plate.caption}</figcaption>}
            </figure>
          )}
        </div>
      )}
    </main>
    {/* The footer: what Sbu is, then three short lists under visible headings (the apps you can download,
        the pages about Sbu, the free tools), then the colophon with the profiles and the language. */}
    <footer class="border-t border-line">
      <div class="frame site-footer py-12">
        <div class="site-footer-about flex flex-col gap-4">
          <a href={localePath(locale, '')} class="self-start py-2 text-brand">
            <Fragment set:html={logo} />
            <span class="sr-only">sbu.dev</span>
          </a>
          <p class="max-w-[32ch] text-subheadline text-ink-muted">{t.siteDescription}</p>
        </div>
        {[
          { id: 'footer-apps', label: t.footerApps, items: footerApps },
          { id: 'footer-site', label: t.footerSite, items: footer.filter((item) => !tools.has(item.href)) },
          { id: 'footer-tools', label: t.footerTools, items: footer.filter((item) => tools.has(item.href)) },
        ].map((group) => (
          <nav aria-labelledby={group.id} class="flex flex-col gap-3">
            <p id={group.id} class="text-caption uppercase text-ink-muted">{group.label}</p>
            <ul class="flex flex-col gap-2 text-subheadline">
              {group.items.map((item) => <li><a href={item.href} class="site-footer-link" aria-current={item.href === here ? 'page' : undefined}>{item.label}</a></li>)}
            </ul>
          </nav>
        ))}
        <div class="site-footer-note flex flex-col gap-3 border-t border-line pt-6 text-footnote text-ink-muted">
          <ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <li><a href={REPO_URL} class="site-footer-link inline-flex items-center gap-2"><GitHubMark class="h-4 w-4" />{t.code}</a></li>
            {SOCIAL.map((profile) => <li><a href={profile.href} rel="me" class="site-footer-link">{profile.label}</a></li>)}
          </ul>
          <p>{t.footerNote}</p>
          <p>
            © {new Date().getFullYear()} Matteo Giuditta
            {alternates.includes(other) && <> · <a href={localePath(other, path)} hreflang={other} lang={other} class="site-footer-link">{t.otherLocale.label}</a></>}
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
