---
// Every page of the site, in both locales, generated from content (see src/lib/routes.ts).
import AlternativePage from '../views/AlternativePage.astro';
import Alternatives from '../views/Alternatives.astro';
import AppPage from '../views/AppPage.astro';
import Blog from '../views/Blog.astro';
import Home from '../views/Home.astro';
import Press from '../views/Press.astro';
import QrCode from '../views/QrCode.astro';
import SubscriptionCost from '../views/SubscriptionCost.astro';
import TextPage from '../views/TextPage.astro';
import { routes, urlParam, type Route } from '../lib/routes';

export async function getStaticPaths() {
  return (await routes()).map((route) => ({ params: { path: urlParam(route) }, props: route }));
}

const route = Astro.props as Route;
const views = {
  home: Home,
  app: AppPage,
  subscriptionCost: SubscriptionCost,
  qrCode: QrCode,
  press: Press,
  alternative: AlternativePage,
  alternatives: Alternatives,
  principles: TextPage,
  support: TextPage,
  privacy: TextPage,
  appPrivacy: TextPage,
  blog: Blog,
  post: Blog,
};
const View = views[route.view];
---
<View {...route} />
