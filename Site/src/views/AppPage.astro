---
import FreeBadge from '../components/FreeBadge.astro';
import PageTitle from '../components/PageTitle.astro';
import ToolFieldShot from '../components/ToolFieldShot.astro';
import Base from '../layouts/Base.astro';
import { capitalize, formatDate, formatPrice, localePath, statusLabel, ui } from '../i18n';
import { plateCaption, text, type App } from '../lib/apps';
import { breadcrumbs, faqPage } from '../lib/jsonld';
import { REPO_URL } from '../lib/pages';
import type { Route } from '../lib/routes';

type Props = Route & { app: App };
const { locale, path, alternates, app, alternatives } = Astro.props;
const t = ui[locale];
const listing = text(app, locale);
const faq = app.faq[locale];
const originale = app.originale;
const alternative = alternatives.find((entry) => entry.app.slug === app.slug && entry.locale === locale);
const site = Astro.site!;
const url = new URL(localePath(locale, path), site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: listing.name,
    description: `${capitalize(listing.oneThing)}.`,
    url,
    image: new URL(app.icon, site).href,
    operatingSystem: 'iOS 17',
    applicationCategory: app.category,
    inLanguage: ['it', 'en'],
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'EUR' },
    ...(app.storeUrl && { downloadUrl: app.storeUrl, installUrl: app.storeUrl }),
  },
  breadcrumbs(site, locale, [[t.nav.apps, ''], [listing.name, path]]),
  ...(faq.length ? [faqPage(faq)] : []),
];
---
<Base
  locale={locale}
  path={path}
  alternates={alternates}
  title={`${listing.name}: ${listing.subtitle} · sbu.dev`}
  description={`${listing.name} ${listing.oneThing}. ${t.metaSuffix}`}
  image={`/og/${app.slug}.png`}
  jsonLd={jsonLd}
  plate={app.engraving ? { src: app.engraving, caption: plateCaption(app.slug, app.order, locale), lead: true } : false}
>
  <article class="app flex flex-col gap-12 py-8" style={`--c: var(--sbu-${app.accent})`}>
    {/* The instrument behind the app is the page's plate, beside the column (Base.astro). */}
    <header class="hero">
      <div class="flex flex-col gap-4">
        <p class="text-footnote text-ink-muted tabular-nums">{t.number(app.order)}</p>
        <PageTitle text={listing.name} accent={app.accent} size="hero" />
        <p class="text-title-2 text-ink-muted">{listing.subtitle}</p>
        {listing.intro.map((paragraph) => <p>{paragraph}</p>)}
        {originale?.price !== undefined && (
          /* The paid app this one remakes, and its public price: a fact, dated in the footnote below. */
          <p class="instead">
            <span class="text-ink-muted">{t.insteadOf} {originale.name}</span>
            <span class="text-ink-muted tabular-nums line-through">{formatPrice(originale.price, locale)}</span>
            <span class="font-[var(--text-headline--font-weight)] tabular-nums"><span class="sr-only">{listing.name}: </span>{formatPrice(0, locale)}</span>
          </p>
        )}
        <p class="flex flex-wrap items-center gap-3">
          {app.storeUrl ? (
            <a href={app.storeUrl} class="cta">{t.appStore}</a>
          ) : (
            <span class="text-headline text-ink-muted">{statusLabel(app, locale)}</span>
          )}
          <span class="text-footnote text-ink-muted">{t.requires}</span>
        </p>
        <FreeBadge locale={locale} />
      </div>
    </header>

    <div class="reveal"><ToolFieldShot app={app} locale={locale} /></div>

    <section aria-labelledby="features" class="flex flex-col gap-4">
      <h2 id="features" class="text-title-2">{t.features}</h2>
      <ol class="features">
        {listing.features.map((feature, index) => (
          <li class="reveal">
            <span aria-hidden="true" class="font-display tabular-nums text-ink-muted">{String(index + 1).padStart(2, '0')}</span>
            <span>{feature}</span>
          </li>
        ))}
      </ol>
    </section>

    {faq.length > 0 && (
      <section aria-labelledby="faq" class="flex flex-col gap-4">
        <h2 id="faq" class="text-title-2">{t.faq}</h2>
        <div class="border-t border-line">
          {faq.map((item) => (
            <details class="faq border-b border-line">
              <summary class="text-headline">{item.q}</summary>
              <p class="pb-4 text-ink-muted">{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <ul class="flex flex-col gap-2">
      {alternative && <li><a href={localePath(locale, `alternatives/${alternative.slug}`)}>{t.alternativeLink(app.originale?.name ?? '')}</a></li>}
      <li><a href={localePath(locale, `privacy/${app.slug}`)}>{t.privacyLink(listing.name)}</a></li>
      <li><a href={`${REPO_URL}/tree/main/Apps/${app.app}`}>{t.codeOf(listing.name)}</a></li>
    </ul>
    {originale?.checked && <p class="text-footnote text-ink-muted">{t.priceSource(formatDate(originale.checked, locale))}</p>}
  </article>
</Base>

<style>
  .hero :global(h1) {
    font-size: clamp(var(--text-display-title), 9vw, var(--text-display-hero));
    line-height: 1;
    letter-spacing: var(--text-display-hero--letter-spacing);
  }

  .instead { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--spacing-1) var(--spacing-3); }

  .cta {
    display: inline-block;
    padding: var(--spacing-3) var(--spacing-6);
    border-radius: var(--radius-lg);
    background: var(--c);
    color: var(--sbu-on-accent);
    font-size: var(--text-headline);
    font-weight: var(--text-headline--font-weight);
    text-decoration: none;
  }

  .features { display: grid; border-top: var(--sbu-hairline) solid var(--sbu-line); }
  .features li {
    display: grid;
    grid-template-columns: calc(var(--spacing-12) * 1.5) minmax(0, 1fr);
    align-items: baseline;
    padding-block: var(--spacing-4);
    border-bottom: var(--sbu-hairline) solid var(--sbu-line);
  }
  .features li > :first-child { font-size: var(--text-title-2); line-height: 1; }

  .faq summary {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-4);
    padding-block: var(--spacing-4);
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; color: var(--sbu-ink-muted); transition: rotate .2s; }
  .faq[open] summary::after { rotate: 45deg; }

  @media (prefers-reduced-motion: no-preference) {
    /* Where the browser has scroll timelines, each block rises in as it enters the screen. */
    @supports (animation-timeline: view()) {
      .reveal { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 80%; }
      @keyframes rise { from { opacity: 0; translate: 0 var(--spacing-6); } }
    }
  }
</style>
