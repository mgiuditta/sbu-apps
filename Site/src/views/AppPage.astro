---
import PageTitle from '../components/PageTitle.astro';
import StoreBadge from '../components/StoreBadge.astro';
import ToolFieldShot from '../components/ToolFieldShot.astro';
import Base from '../layouts/Base.astro';
import { capitalize, formatDate, formatPrice, localePath, statusLabel, ui } from '../i18n';
import { plateCaption, text, type App } from '../lib/apps';
import { breadcrumbs, faqPage } from '../lib/jsonld';
import { REPO_URL } from '../lib/pages';
import type { Route } from '../lib/routes';

type Props = Route & { app: App };
const { locale, path, alternates, app, alternatives } = Astro.props;
const t = ui[locale];
const listing = text(app, locale);
const faq = app.faq[locale];
const originale = app.originale;
const alternative = alternatives.find((entry) => entry.app.slug === app.slug && entry.locale === locale);
const site = Astro.site!;
const url = new URL(localePath(locale, path), site).href;
// The scheda's cartiglio: catalogue number and slug, the paid app it replaces and that app's public price
// (one-time on the Italian App Store, the only price the repo keeps), then what it costs with Sbu.
// Kept as parts, each unbreakable, so on a phone the line wraps only at a separator.
const cartiglio = [
  `SBU / ${String(app.order).padStart(2, '0')} / ${app.slug}`,
  originale && t.replaces(originale.name),
  originale?.price !== undefined && t.oneTime(formatPrice(originale.price, locale)),
  originale?.cost?.[locale],
].filter((part): part is string => Boolean(part));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: listing.name,
    description: `${capitalize(listing.oneThing)}.`,
    url,
    image: new URL(app.icon, site).href,
    operatingSystem: 'iOS 17',
    applicationCategory: app.category,
    inLanguage: ['it', 'en'],
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'EUR' },
    ...(app.storeUrl && { downloadUrl: app.storeUrl, installUrl: app.storeUrl }),
  },
  breadcrumbs(site, locale, [[t.nav.apps, ''], [listing.name, path]]),
  ...(faq.length ? [faqPage(faq)] : []),
];
// Search title: the job first, as people type it, then the name. "per iPhone" goes when it would pass 60 characters.
const job = `${listing.subtitle}, ${locale === 'it' ? 'gratis' : 'free'}`;
const forIphone = locale === 'it' ? ' per iPhone' : ' for iPhone';
const title = [`${job}${forIphone} · ${listing.name}`, `${job} · ${listing.name}`].find((candidate) => candidate.length <= 60) ?? `${job} · ${listing.name}`;
---
<Base
  locale={locale}
  path={path}
  alternates={alternates}
  title={title}
  description={`${listing.name} ${listing.oneThing}. ${t.metaSuffix}`}
  image={`/og/${app.slug}.png`}
  jsonLd={jsonLd}
  appStoreId={app.storeUrl ? app.appStoreId : undefined}
  plate={app.engraving ? { src: app.engraving, caption: plateCaption(app.slug, undefined, locale), lead: true } : false}
>
  {/* The scheda: the title closed by the full stop in the app's accent (the page's one colored square)
      over its cartiglio, the figure on the grid, then what it does and what it does not. Everything else is ink. */}
  <article class="scheda">
    <header class="scheda-head">
      <div class="grid">
        <PageTitle text={listing.name} accent={app.accent} size="hero" />
        <p class="cartiglio">
          {cartiglio.map((part, index) => <>{index > 0 && ' · '}<span class="whitespace-nowrap">{part}{index === cartiglio.length - 1 && originale && <> <span aria-hidden="true">→</span><span class="sr-only">, {t.withSbu}:</span> {formatPrice(0, locale)}</>}</span></>)}
        </p>
      </div>
      <p class="lede">{listing.subtitle}</p>
      {listing.intro.map((paragraph) => <p>{paragraph}</p>)}
      <p class="flex flex-wrap items-center gap-x-6 gap-y-0">
        {app.storeUrl ? (
          <StoreBadge appStoreId={app.appStoreId!} campaign={`site-${app.slug}`} locale={locale} />
        ) : (
          <span class="cartiglio text-ink">{statusLabel(app, locale)}</span>
        )}
        <span class="text-footnote leading-[var(--sbu-grid-cell)] text-ink-muted">{t.requires}</span>
      </p>
    </header>

    <div class="reveal"><ToolFieldShot app={app} locale={locale} /></div>

    <div class="does">
      <section aria-labelledby="features">
        <h2 id="features" class="section-title">{t.features}</h2>
        <ul class="marks">
          {listing.features.map((feature) => (
            <li class="reveal"><span aria-hidden="true" class="row-mark"></span><span>{feature}</span></li>
          ))}
        </ul>
      </section>
      <section aria-labelledby="does-not">
        <h2 id="does-not" class="section-title">{t.doesNot}</h2>
        <ul class="marks">
          {t.doesNotList.map((line) => (
            <li class="reveal"><span aria-hidden="true" class="row-mark is-empty"></span><span>{line}</span></li>
          ))}
        </ul>
      </section>
    </div>

    {faq.length > 0 && (
      <section aria-labelledby="faq">
        <h2 id="faq" class="section-title">{t.faq}</h2>
        <div class="border-t border-line">
          {faq.map((item) => (
            <details class="faq border-b border-line">
              <summary class="text-headline">{item.q}</summary>
              <p class="pb-6 text-ink-muted">{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <ul class="flex flex-col">
      {alternative && <li><a href={localePath(locale, `alternatives/${alternative.slug}`)}>{t.alternativeLink(app.originale?.name ?? '')}</a></li>}
      <li><a href={localePath(locale, `privacy/${app.slug}`)}>{t.privacyLink(listing.name)}</a></li>
      <li><a href={`${REPO_URL}/tree/main/Apps/${app.app}`}>{t.codeOf(listing.name)}</a></li>
    </ul>
    {originale?.checked && <p class="text-footnote text-ink-muted">{t.priceSource(formatDate(originale.checked, locale))}</p>}
  </article>
</Base>

<style>
  /* Every block is a whole number of grid rows apart, and every line of running text is one row tall. */
  .scheda {
    display: flex;
    flex-direction: column;
    gap: calc(var(--sbu-grid-cell) * 2);
    padding-block: var(--sbu-grid-cell);
    line-height: var(--sbu-grid-cell);
  }
  .scheda-head { display: flex; flex-direction: column; gap: var(--sbu-grid-cell); }
  .lede {
    font-size: var(--text-title-2);
    line-height: calc(var(--sbu-grid-cell) * 1.5);
    color: var(--sbu-ink-muted);
  }
  .section-title {
    margin-bottom: var(--sbu-grid-cell);
    font-family: var(--font-display);
    font-stretch: var(--title-stretch);
    font-size: var(--text-title-2);
    line-height: calc(var(--sbu-grid-cell) * 2);
    font-weight: var(--text-title--font-weight);
  }

  /* Fa / non fa: side by side from a tablet up, one row of the grid per line, the mark on the first line. */
  .does { display: grid; gap: calc(var(--sbu-grid-cell) * 2); }
  @media (min-width: 40rem) {
    .does { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .marks { display: grid; gap: var(--sbu-grid-cell); }
  .marks li {
    display: grid;
    grid-template-columns: var(--sbu-grid-cell) minmax(0, 1fr);
    align-items: start;
  }
  /* Centered on the first line's row: (row - mark) / 2 from its top. */
  .marks .row-mark { margin-top: calc((var(--sbu-grid-cell) - var(--sbu-row-mark)) / 2); }

  .faq summary {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-4);
    padding-block: var(--sbu-grid-cell);
    line-height: var(--sbu-grid-cell);
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; color: var(--sbu-ink-muted); }
  @media (prefers-reduced-motion: no-preference) {
    .faq summary::after { transition: rotate var(--sbu-motion-short) ease-out; }
  }
  .faq[open] summary::after { rotate: 45deg; }

  @media (prefers-reduced-motion: no-preference) {
    /* Where the browser has scroll timelines, each block rises in as it enters the screen. */
    @supports (animation-timeline: view()) {
      .reveal { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 80%; }
      @keyframes rise { from { opacity: 0; translate: 0 var(--sbu-grid-cell); } }
    }
  }
</style>
