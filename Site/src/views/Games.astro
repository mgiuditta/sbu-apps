---
// The games branch: the most played free games, remade without ads (ADR-0015). Each links to its app page.
import PageTitle from '../components/PageTitle.astro';
import Base from '../layouts/Base.astro';
import { capitalize, localePath, statusLabel } from '../i18n';
import { text } from '../lib/apps';
import { breadcrumbs } from '../lib/jsonld';
import type { Route } from '../lib/routes';

type Props = Route & { view: 'games' };
const { locale, path, alternates, apps } = Astro.props;
const copy = {
  it: {
    title: 'Giochi senza pubblicità',
    metaTitle: 'Giochi per iPhone senza pubblicità e senza acquisti · sbu.dev',
    description: 'I giochi più giocati dell’App Store, rifatti senza pubblicità, senza acquisti, senza vite né attese. Uno al mese, per iPhone.',
    lede: 'I giochi in cima alla classifica sono già gratis: il prezzo è una pubblicità ogni due partite. Sbu li rifà senza: niente pubblicità, niente acquisti, niente vite da ricaricare, niente notifiche per farti tornare. Uno al mese.',
    soon: 'Il primo è in arrivo. Ogni mese un gioco nuovo.',
  },
  en: {
    title: 'Games without ads',
    metaTitle: 'iPhone games with no ads and no purchases · sbu.dev',
    description: 'The most played games on the App Store, remade with no ads, no purchases, no lives and no waiting. One a month, for iPhone.',
    lede: 'The games at the top of the charts are already free: the price is an ad every other game. Sbu remakes them without: no ads, no purchases, no lives to refill, no notifications to pull you back. One a month.',
    soon: 'The first one is on its way. A new game every month.',
  },
}[locale];

const games = apps
  .filter((app) => app.category === 'GameApplication')
  .map((app) => {
    const listing = text(app, locale);
    return {
      name: listing.name,
      line: `${capitalize(listing.oneThing)}.`,
      href: localePath(locale, `apps/${app.slug}`),
      meta: statusLabel(app, locale),
      mark: app.mark,
    };
  });

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: copy.title,
    itemListElement: games.map((game, index) => ({ '@type': 'ListItem', position: index + 1, name: game.name, url: new URL(game.href, site).href })),
  },
  breadcrumbs(site, locale, [['sbu.dev', ''], [copy.title, path]]),
];
---
<Base locale={locale} path={path} alternates={alternates} title={copy.metaTitle} description={copy.description} jsonLd={jsonLd}>
  <article class="flex flex-col gap-12 py-8">
    <header class="flex flex-col gap-4">
      <PageTitle text={copy.title} />
      <p class="text-ink-muted">{copy.lede}</p>
    </header>

    {games.length > 0 ? (
      <ul class="rows">
        {games.map((game) => (
          <li class="row">
            {game.mark && <span class="engraving" style={`--engraving: url(${game.mark})`} aria-hidden="true"></span>}
            <div class="flex flex-col gap-1">
              <h2 class="text-headline"><a href={game.href}>{game.name}</a></h2>
              <p class="text-ink-muted">{game.line}</p>
              <p class="cartiglio">{game.meta}</p>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p>{copy.soon}</p>
    )}
  </article>
</Base>

<style>
  .rows { display: grid; border-top: var(--sbu-hairline) solid var(--sbu-line); }
  .row { display: grid; grid-template-columns: calc(var(--sbu-grid-cell) * 4) 1fr; gap: var(--sbu-grid-cell); align-items: center; padding-block: var(--spacing-4); border-bottom: var(--sbu-hairline) solid var(--sbu-line); }
  .engraving { display: block; aspect-ratio: 1; background: var(--sbu-ink); mask: var(--engraving) center / contain no-repeat; }
  @media (forced-colors: active) { .engraving { forced-color-adjust: none; background: CanvasText; } }
</style>
