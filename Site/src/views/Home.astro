---
// The home is a bill. Each row is an App Sbu next to the paid app it remakes and that app's public price;
// the sum of those prices is the page's one figure, struck out, because with Sbu it is 0 €.
// Then the queue of announced apps, the six promises and the free tools. No script: CSS only.
import Base from '../layouts/Base.astro';
import mark from '../../../Design/logos/sbu-mark.svg?url';
import { capitalize, formatDate, formatPrice, localePath, ui } from '../i18n';
import { text } from '../lib/apps';
import type { Route } from '../lib/routes';

type Props = Route & { view: 'home' };
const { locale, path, alternates, apps, upcoming } = Astro.props;
const t = ui[locale];
const copy = {
  it: {
    title: 'sbu.dev · App gratuite per iPhone che fanno una cosa sola',
    hero: 'Sbu fa una cosa sola',
    lede: 'App per iPhone che rifanno da zero un’app a pagamento, una per volta. Gratis, senza account, senza pubblicità.',
    notPaid: 'Non paghi',
    figureLabel: (count: number) => (count === 1 ? 'Quanto costa l’app a pagamento che Sbu rifà.' : `Quanto costano le ${count} app a pagamento che Sbu rifà.`),
    withSbu: 'Con Sbu',
    bill: 'Il conto',
    billLede: 'Ogni riga è un’app Sbu e l’app a pagamento che rifà da zero, con un codice e una grafica nuovi.',
    columns: { app: 'App Sbu', originale: 'Invece di', price: 'Costa', sbu: 'Sbu' },
    total: 'Totale',
    live: 'Sull’App Store',
    pricesSource: (date: string) => `Prezzi una tantum sull’App Store italiano, verificati il ${date}. I nomi delle app sono dei rispettivi proprietari.`,
    queue: 'In coda',
    queueLede: 'App annunciate, ancora senza scheda. Arrivano in quest’ordine.',
    promises: 'Sei promesse, in ogni app',
    promisesClose: 'Se un’app ne viola una, non esce.',
    principles: 'Leggi i principi',
    tools: 'Nel browser, senza app',
    level: { title: 'Livella online', line: 'Appoggia il telefono e leggi l’inclinazione al decimo di grado.' },
    subscriptions: { title: 'Quanto spendi in abbonamenti', line: 'Scrivi gli abbonamenti che paghi e guarda il totale dell’anno.' },
  },
  en: {
    title: 'sbu.dev · Free iPhone apps that each do one thing',
    hero: 'Sbu does one thing',
    lede: 'iPhone apps that each remake one paid app from scratch. Free, no account, no ads.',
    notPaid: 'You don’t pay',
    figureLabel: (count: number) => (count === 1 ? 'What the paid app Sbu remakes costs.' : `What the ${count} paid apps Sbu remakes cost.`),
    withSbu: 'With Sbu',
    bill: 'The bill',
    billLede: 'Each row is a Sbu app and the paid app it remakes from scratch, with new code and new design.',
    columns: { app: 'Sbu app', originale: 'Instead of', price: 'Costs', sbu: 'Sbu' },
    total: 'Total',
    live: 'On the App Store',
    pricesSource: (date: string) => `One-time prices on the Italian App Store, checked on ${date}. App names belong to their owners.`,
    queue: 'Next up',
    queueLede: 'Announced apps, with no page yet. They come in this order.',
    promises: 'Six promises, in every app',
    promisesClose: 'If an app breaks one, it does not ship.',
    principles: 'Read the principles',
    tools: 'In your browser, no app',
    level: { title: 'Bubble level online', line: 'Lay your phone down and read the tilt to a tenth of a degree.' },
    subscriptions: { title: 'What your subscriptions cost', line: 'Write down the subscriptions you pay and see the yearly total.' },
  },
}[locale];

const rows = apps.map((app) => {
  const listing = text(app, locale);
  return {
    slug: app.slug,
    accent: app.accent,
    name: listing.name,
    line: `${capitalize(listing.oneThing)}.`,
    href: localePath(locale, `apps/${app.slug}`),
    live: app.status === 'live',
    mark: app.mark,
    originale: app.originale,
  };
});
const priced = rows.filter((row) => row.originale?.price !== undefined);
const total = priced.reduce((sum, row) => sum + row.originale!.price!, 0);
// The oldest check is the one the whole bill can promise.
const checked = priced.map((row) => row.originale!.checked!).sort((a, b) => +a - +b)[0];
const zero = formatPrice(0, locale);
const words = copy.hero.split(' ');
const markOf = (slug: string) => apps.find((app) => app.slug === slug)?.mark ?? upcoming.find((app) => app.slug === slug)?.mark;
const tools = [
  { href: localePath(locale, 'livella'), accent: 'accent-level', mark: markOf('level'), ...copy.level },
  { href: localePath(locale, 'abbonamenti'), accent: 'accent-subscriptions', mark: markOf('subscriptions'), ...copy.subscriptions },
];

const site = Astro.site!.href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'sbu.dev', url: site, logo: new URL(mark, site).href },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'sbu.dev', url: site, inLanguage: locale, description: t.siteDescription },
];
---
<Base locale={locale} path={path} alternates={alternates} title={copy.title} description={t.siteDescription} jsonLd={jsonLd} layout="wide">
  <section class="hero">
    <div class="hero-words">
      {/* The page title, closed by the full stop: the only square on the page. */}
      <h1 class="hero-title">
        {words.map((word, index) =>
          index < words.length - 1 ? (
            <><span class="hero-word" style={`--i: ${index}`}>{word}</span>{' '}</>
          ) : (
            <span class="hero-word whitespace-nowrap" style={`--i: ${index}`}>{word}<span aria-hidden="true" class="full-stop hero-stop" style={`--i: ${words.length}`}></span></span>
          ),
        )}
      </h1>
      <p class="hero-lede">{copy.lede}</p>
    </div>
    {priced.length > 0 && (
      <figure class="hero-figure">
        {/* The Cifra: one per page, in ink. Struck out because it is the price you don't pay. */}
        <p class="figure"><span class="sr-only">{copy.notPaid}: </span><s class="struck">{formatPrice(total, locale)}</s></p>
        <figcaption class="flex flex-col gap-1">
          <span class="text-subheadline text-ink-muted">{copy.figureLabel(priced.length)}</span>
          <span class="text-headline">{copy.withSbu}: <span class="tabular-nums">{zero}</span>.</span>
        </figcaption>
      </figure>
    )}
  </section>

  <section aria-labelledby="bill" class="section">
    <h2 id="bill" class="section-title">{copy.bill}</h2>
    <p class="section-lede">{copy.billLede}</p>
    <div class="bill">
      <div class="bill-row bill-head" aria-hidden="true">
        <span></span>
        <span>{copy.columns.app}</span>
        <span>{copy.columns.originale}</span>
        <span class="num">{copy.columns.price}</span>
        <span class="num">{copy.columns.sbu}</span>
      </div>
      <ol class="bill-rows">
        {rows.map((row) => (
          <li class="bill-row is-app" style={`--c: var(--sbu-${row.accent})`}>
            {row.mark ? <span class="engraving" style={`--engraving: url(${row.mark})`} aria-hidden="true"></span> : <span></span>}
            <div class="bill-app">
              {/* The name is the row's link; its ::after stretches over the row, so the whole row is the target. */}
              <h3 class="text-headline"><a href={row.href} class="bill-link">{row.name}</a></h3>
              <p class="text-subheadline text-ink-muted">{row.line}</p>
              <p class="text-footnote text-ink-muted">{row.live ? copy.live : t.comingSoon}</p>
            </div>
            <p class="bill-was">
              {row.originale?.price !== undefined && (
                <>
                  <span class="bill-originale"><span class="label">{copy.columns.originale} </span>{row.originale.name}</span>
                  <span class="num text-ink-muted"><span class="sr-only">{copy.columns.price} </span>{formatPrice(row.originale.price, locale)}</span>
                </>
              )}
            </p>
            <p class="num bill-sbu"><span class="sr-only">{copy.columns.sbu}: </span>{zero}</p>
          </li>
        ))}
      </ol>
      {priced.length > 0 && (
        <p class="bill-row bill-total">
          <span></span>
          <span class="text-headline">{copy.total}</span>
          <span class="bill-was">
            <span class="bill-originale"></span>
            <span class="num text-ink-muted"><span class="sr-only">{copy.columns.price} </span>{formatPrice(total, locale)}</span>
          </span>
          <span class="num bill-sbu"><span class="sr-only">{copy.columns.sbu}: </span>{zero}</span>
        </p>
      )}
    </div>
    {checked && <p class="text-footnote text-ink-muted">{copy.pricesSource(formatDate(checked, locale))}</p>}
  </section>

  {upcoming.length > 0 && (
    <section aria-labelledby="queue" class="section">
      <h2 id="queue" class="section-title">{copy.queue}</h2>
      <p class="section-lede">{copy.queueLede}</p>
      <ol class="queue">
        {upcoming.map((app, index) => (
          <li class="queue-item">
            <span class="queue-n tabular-nums" aria-hidden="true">{index + 1}</span>
            {app.mark && <span class="engraving" style={`--engraving: url(${app.mark})`} aria-hidden="true"></span>}
            <h3 class="text-headline">{app.name}</h3>
            <p class="text-subheadline text-ink-muted">{app.teaser[locale]}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section aria-labelledby="promises" class="section">
    <h2 id="promises" class="section-title">{copy.promises}</h2>
    <ul class="promises">
      {t.promises.map((promise) => <li>{promise}</li>)}
    </ul>
    <p class="text-ink-muted">{copy.promisesClose} <a href={localePath(locale, 'principi')} class="underline">{copy.principles}</a></p>
  </section>

  <section aria-labelledby="tools" class="section">
    <h2 id="tools" class="section-title">{copy.tools}</h2>
    <ul class="tools">
      {tools.map((tool) => (
        <li class="tool" style={`--c: var(--sbu-${tool.accent})`}>
          {tool.mark && <span class="engraving" style={`--engraving: url(${tool.mark})`} aria-hidden="true"></span>}
          <h3 class="text-title-2"><a href={tool.href} class="bill-link">{tool.title}</a></h3>
          <p class="text-ink-muted">{tool.line}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  /* Only design tokens: sizes are multiples of the type and spacing steps, colors are --sbu-*. */
  .hero {
    display: grid;
    gap: var(--spacing-12);
    padding-block: var(--spacing-8) var(--spacing-12);
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      padding-block: var(--spacing-12) calc(var(--spacing-12) * 2);
    }
  }
  .hero-words { display: grid; gap: var(--spacing-6); }
  .hero-title {
    font-family: var(--font-display);
    font-weight: var(--text-display-hero--font-weight);
    /* display-hero at its smallest, up to twice that on a wide screen. */
    font-size: clamp(var(--text-display-hero), 9vw, calc(var(--text-display-hero) * 2));
    line-height: 1; /* display-hero: 56px on 56px */
    letter-spacing: -.035em; /* display-hero's -2px at 56px, kept as a ratio when it grows */
    text-wrap: balance;
  }
  .hero-word { display: inline-block; }
  .hero-lede {
    max-width: 36ch;
    font-size: var(--text-title-2);
    line-height: var(--text-title-2--line-height);
    color: var(--sbu-ink-muted);
  }

  /* The figure, measured on its own column so it never overflows. */
  .hero-figure { display: grid; gap: var(--spacing-3); container-type: inline-size; }
  .figure {
    font-family: var(--font-display);
    font-weight: var(--text-stat-hero--font-weight);
    font-size: clamp(var(--text-stat-hero), 24cqi, calc(var(--text-stat-hero) * 2.25));
    line-height: 1;
    letter-spacing: -.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .struck { position: relative; text-decoration: none; }
  /* The strike is a rule of ink across the figure, a little thicker than the hairline so it reads at size. */
  .struck::after {
    content: "";
    position: absolute;
    inset: 52% calc(var(--spacing-1) * -1) auto;
    height: max(var(--spacing-1), .06em);
    background: currentColor;
    transform-origin: left center;
  }

  .section {
    display: grid;
    gap: var(--spacing-4);
    padding-block: var(--spacing-12);
    border-top: var(--sbu-hairline) solid var(--sbu-line);
  }
  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-display-title);
    line-height: var(--text-display-title--line-height);
    font-weight: var(--text-display-title--font-weight);
    letter-spacing: var(--text-display-title--letter-spacing);
  }
  .section-lede { max-width: 60ch; color: var(--sbu-ink-muted); }

  /* The bill. On a phone: engraving, then the app and its 0 €, then what it replaces under it. */
  .bill { margin-top: var(--spacing-4); }
  .bill-row {
    --mark: calc(var(--spacing-12) * 1.25);
    position: relative;
    display: grid;
    grid-template-columns: var(--mark) minmax(0, 1fr) auto;
    grid-template-areas: "mark app sbu" "mark was was";
    column-gap: var(--spacing-4);
    row-gap: var(--spacing-2);
    align-items: baseline;
    padding-block: var(--spacing-4);
    border-bottom: var(--sbu-hairline) solid var(--sbu-line);
  }
  .bill-row > :nth-child(1) { grid-area: mark; align-self: start; }
  .bill-row > :nth-child(2) { grid-area: app; }
  .bill-row > :nth-child(3) { grid-area: was; }
  .bill-row > :nth-child(4) { grid-area: sbu; }
  .bill-head { display: none; }
  .bill-app { display: grid; gap: var(--spacing-1); }
  .bill-was { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--spacing-1) var(--spacing-4); font-size: var(--text-subheadline); line-height: var(--text-subheadline--line-height); }
  .bill-was:empty { display: none; }
  .bill-was > .num { margin-inline-start: auto; }
  .label { color: var(--sbu-ink-muted); }
  .num { text-align: end; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .bill-sbu { font-weight: var(--text-headline--font-weight); }
  .bill-total { border-bottom: 0; }
  .bill-total .bill-sbu, .bill-total .bill-was .num {
    font-size: var(--text-stat-small);
    line-height: var(--text-stat-small--line-height);
    font-weight: var(--text-stat-small--font-weight);
  }
  .bill-total .bill-was .num { text-decoration: line-through; text-decoration-thickness: calc(var(--sbu-hairline) * 2); }

  @media (min-width: 48rem) {
    .bill-row {
      grid-template-columns: var(--mark) minmax(0, 5fr) minmax(0, 3fr) minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: none;
    }
    .bill-row > :nth-child(n) { grid-area: auto; }
    .bill-was { display: contents; }
    .bill-was:empty { display: block; }
    .bill-row.is-app > .bill-was:empty { grid-column: 3 / span 2; }
    .label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .bill-head {
      display: grid;
      padding-block: var(--spacing-2);
      font-size: var(--text-caption);
      line-height: var(--text-caption--line-height);
      font-weight: var(--text-caption--font-weight);
      letter-spacing: var(--text-caption--letter-spacing);
      text-transform: uppercase;
      color: var(--sbu-ink-muted);
    }
  }

  /* The engraving as an ink mask: it follows the theme, and takes the app's accent when you pick the row. */
  .engraving {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    background: var(--sbu-ink);
    mask: var(--engraving) center / contain no-repeat luminance;
    transition: background-color .25s;
  }
  .bill-link { color: inherit; text-decoration: underline transparent calc(var(--sbu-hairline) * 2); text-underline-offset: var(--spacing-1); transition: text-decoration-color .25s; }
  .bill-link::after { content: ""; position: absolute; inset: 0; }
  .bill-link:focus-visible { outline: none; }
  .is-app:has(.bill-link:focus-visible), .tool:has(.bill-link:focus-visible) {
    outline: calc(var(--sbu-hairline) * 2) solid var(--sbu-focus);
    outline-offset: calc(var(--sbu-hairline) * 2);
  }
  .is-app:hover .engraving, .is-app:focus-within .engraving,
  .tool:hover .engraving, .tool:focus-within .engraving { background: var(--c); }
  .is-app:hover .bill-link, .is-app:focus-within .bill-link,
  .tool:hover .bill-link, .tool:focus-within .bill-link { text-decoration-color: var(--c); }

  /* The queue: a grid of small entries, numbered in the order they come. */
  .queue {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(calc(var(--spacing-12) * 4.5), 1fr));
    gap: var(--spacing-8) var(--spacing-6);
    margin-top: var(--spacing-4);
  }
  .queue-item {
    display: grid;
    grid-template-columns: var(--spacing-6) var(--spacing-12) minmax(0, 1fr);
    grid-template-areas: "n mark name" "n mark line";
    column-gap: var(--spacing-3);
    align-items: start;
  }
  .queue-item > .queue-n { grid-area: n; font-size: var(--text-subheadline); color: var(--sbu-ink-muted); }
  .queue-item > .engraving { grid-area: mark; }
  .queue-item > h3 { grid-area: name; }
  .queue-item > p { grid-area: line; }

  /* The promises: six sentences set large, two columns from a tablet up. */
  .promises {
    display: grid;
    gap: var(--spacing-2) var(--spacing-8);
    margin-block: var(--spacing-4);
    font-family: var(--font-display);
    font-size: clamp(var(--text-title-2), 4vw, var(--text-display-title));
    line-height: 1.15;
    font-weight: var(--text-display-title--font-weight);
    letter-spacing: -.02em;
  }
  @media (min-width: 48rem) {
    .promises { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* The free tools: two entries side by side, each led by the engraving of the app it hands you to. */
  .tools { display: grid; gap: var(--spacing-8); margin-top: var(--spacing-4); }
  @media (min-width: 48rem) {
    .tools { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .tool { position: relative; display: grid; gap: var(--spacing-2); justify-items: start; }
  .tool .engraving { width: calc(var(--spacing-12) * 3); margin-bottom: var(--spacing-2); }

  @media (prefers-reduced-motion: no-preference) {
    /* The title is set word by word, then the full stop is stamped on the baseline, then the figure is struck. */
    .hero-word { animation: set .7s cubic-bezier(.2, .8, .2, 1) calc(var(--i) * 90ms) both; }
    .hero-stop { animation: stamp .3s cubic-bezier(.3, 1.4, .5, 1) calc(var(--i) * 90ms + 250ms) both; transform-origin: left bottom; }
    .hero-lede, .hero-figure { animation: set .7s cubic-bezier(.2, .8, .2, 1) 500ms both; }
    .struck::after { animation: strike .5s cubic-bezier(.6, 0, .2, 1) 1.1s both; }
    @keyframes set { from { opacity: 0; translate: 0 var(--spacing-4); } }
    @keyframes stamp { from { scale: 0; } }
    @keyframes strike { from { scale: 0 1; } }

    /* Where the browser has scroll timelines, each row of the bill is written in as it enters the screen. */
    @supports (animation-timeline: view()) {
      .bill-rows > li, .bill-total, .queue-item, .promises > li {
        animation: set linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
    }
  }
  @media (forced-colors: active) {
    .engraving { forced-color-adjust: none; background: CanvasText; }
    .struck::after { background: CanvasText; }
  }
</style>
