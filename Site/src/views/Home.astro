---
// The home is a squared sheet. Each App Sbu is one filled cell in its accent at the bottom right of its
// engraving, as on its icon; an announced app with no page yet is an empty cell. Then "Il numero": what the
// paid apps Sbu remakes cost, closed by the full stop. Then the six promises and the free tools.
import Base from '../layouts/Base.astro';
import mark from '../../../Design/logos/sbu-mark.svg?url';
import { capitalize, formatDate, formatPrice, localePath, statusLabel, ui } from '../i18n';
import { text } from '../lib/apps';
import { DEVELOPER_URL, PROFILES } from '../lib/pages';
import type { Route } from '../lib/routes';

type Props = Route & { view: 'home' };
const { locale, path, alternates, apps, upcoming } = Astro.props;
const t = ui[locale];
const copy = {
  it: {
    title: 'sbu.dev · App gratuite per iPhone che fanno una cosa sola',
    hero: 'Sbu fa una cosa sola',
    cartiglio: (count: number) => `sbu.dev · ${count} app · 0 €`,
    lede: 'App per iPhone che rifanno da zero un’app a pagamento, una per volta. Gratis, senza account, senza pubblicità.',
    sheet: 'Le app',
    sheetLede: 'Un quadretto per app, nel suo colore. Quelle ancora senza scheda hanno il quadretto vuoto.',
    number: 'Il numero',
    notPaid: 'Non paghi',
    numberLabel: (names: string, count: number) =>
      count === 1 ? `Quanto costa ${names}, l’app a pagamento che Sbu rifà.` : `Quanto costano ${names}, le ${count} app a pagamento che Sbu rifà.`,
    withSbu: (zero: string) => `Con Sbu: ${zero}.`,
    pricesRead: (date: string) => `Prezzi una tantum · App Store Italia · letti il ${date}`,
    owners: 'I nomi delle app sono dei rispettivi proprietari.',
    promises: 'Sei promesse, in ogni app',
    promisesClose: 'Se un’app ne viola una, non esce.',
    principles: 'Leggi i principi',
    tools: 'Nel browser, senza app',
    subscriptions: { title: 'Quanto spendi in abbonamenti', line: 'Scrivi gli abbonamenti che paghi e guarda il totale dell’anno.' },
  },
  en: {
    title: 'sbu.dev · Free iPhone apps that each do one thing',
    hero: 'Sbu does one thing',
    cartiglio: (count: number) => `sbu.dev · ${count} apps · €0`,
    lede: 'iPhone apps that each remake one paid app from scratch. Free, no account, no ads.',
    sheet: 'The apps',
    sheetLede: 'One square per app, in its colour. The ones with no page yet have an empty square.',
    number: 'The number',
    notPaid: 'You don’t pay',
    numberLabel: (names: string, count: number) =>
      count === 1 ? `What ${names} costs, the paid app Sbu remakes.` : `What ${names} cost, the ${count} paid apps Sbu remakes.`,
    withSbu: (zero: string) => `With Sbu: ${zero}.`,
    pricesRead: (date: string) => `One-time prices · Italian App Store · read on ${date}`,
    owners: 'App names belong to their owners.',
    promises: 'Six promises, in every app',
    promisesClose: 'If an app breaks one, it does not ship.',
    principles: 'Read the principles',
    tools: 'In your browser, no app',
    subscriptions: { title: 'What your subscriptions cost', line: 'Write down the subscriptions you pay and see the yearly total.' },
  },
}[locale];

const tiles = apps.map((app) => {
  const listing = text(app, locale);
  return {
    slug: app.slug,
    accent: app.accent,
    name: listing.name,
    line: `${capitalize(listing.oneThing)}.`,
    href: localePath(locale, `apps/${app.slug}`),
    meta: `${t.number(app.order)} · ${statusLabel(app, locale)}`,
    mark: app.mark,
  };
});
const waiting = upcoming.map((app) => ({
  slug: app.slug,
  name: app.name,
  line: app.teaser[locale],
  meta: `${t.number(app.order)} · ${statusLabel(app, locale)}`,
  mark: app.mark,
}));

// Il numero: the public one-time prices kept in the app content files (checked against research/ at build),
// summed. The oldest reading date is the one the whole figure can promise.
const priced = apps.filter((app) => app.originale?.price !== undefined).map((app) => app.originale!);
const total = priced.reduce((sum, originale) => sum + originale.price!, 0);
const read = priced.map((originale) => originale.checked!).sort((a, b) => +a - +b)[0];
const names = new Intl.ListFormat(locale, { type: 'conjunction' }).format(priced.map((originale) => originale.name));
const figure = formatPrice(total, locale);
const zero = formatPrice(0, locale);
const words = copy.hero.split(' ');
const markOf = (slug: string) => apps.find((app) => app.slug === slug)?.mark ?? upcoming.find((app) => app.slug === slug)?.mark;
const tools = [{ href: localePath(locale, 'abbonamenti'), mark: markOf('subscriptions'), ...copy.subscriptions }];

const site = Astro.site!.href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'sbu.dev',
    url: site,
    logo: new URL(mark, site).href,
    sameAs: PROFILES,
    founder: { '@type': 'Person', name: 'Matteo Giuditta', sameAs: ['https://github.com/mgiuditta', DEVELOPER_URL] },
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'sbu.dev', url: site, inLanguage: locale, description: t.siteDescription },
];
---
<Base locale={locale} path={path} alternates={alternates} title={copy.title} description={t.siteDescription} jsonLd={jsonLd} layout="wide">
  <section class="hero">
    {/* The page title, closed by the full stop in ink: the site's own square. */}
    <h1 class="hero-title font-display">
      {words.map((word, index) =>
        index < words.length - 1 ? (
          <><span class="hero-word" style={`--i: ${index}`}>{word}</span>{' '}</>
        ) : (
          <span class="hero-word whitespace-nowrap" style={`--i: ${index}`}>{word}<span aria-hidden="true" class="full-stop is-hero" data-hero-stop style={`--stamp-delay: calc(${words.length} * var(--sbu-motion-short) / 2)`}></span></span>
        ),
      )}
    </h1>
    <p class="cartiglio">{copy.cartiglio(apps.length + upcoming.length)}</p>
    <p class="hero-lede">{copy.lede}</p>
  </section>

  <section aria-labelledby="sheet" class="section">
    <h2 id="sheet" class="section-title font-display">{copy.sheet}</h2>
    <p class="section-lede">{copy.sheetLede}</p>
    <ol class="tiles">
      {tiles.map((tile) => (
        <li class="tile" style={`--c: var(--sbu-${tile.accent})`}>
          <span class="tile-art" aria-hidden="true">
            {tile.mark && <span class="engraving" style={`--engraving: url(${tile.mark})`}></span>}
            <span class="cell" data-cell></span>
          </span>
          {/* The name is the tile's link; its ::after stretches over the tile, so the whole tile is the target. */}
          <h3 class="tile-name font-display"><a href={tile.href} class="tile-link" data-tile-link>{tile.name}</a></h3>
          <p class="tile-line">{tile.line}</p>
          <p class="cartiglio">{tile.meta}</p>
        </li>
      ))}
      {waiting.map((tile) => (
        <li class="tile is-waiting">
          <span class="tile-art" aria-hidden="true">
            {tile.mark && <span class="engraving" style={`--engraving: url(${tile.mark})`}></span>}
            <span class="cell"></span>
          </span>
          <h3 class="tile-name font-display">{tile.name}</h3>
          <p class="tile-line">{tile.line}</p>
          <p class="cartiglio">{tile.meta}</p>
        </li>
      ))}
    </ol>
  </section>

  {priced.length > 0 && (
    <section aria-labelledby="number" class="section">
      <h2 id="number" class="section-title font-display">{copy.number}</h2>
      <figure class="number">
        {/* The Cifra, in ink, as wide as the frame allows, closed by a full stop of one cell. */}
        <p class="number-figure font-display" style={`--chars: ${[...figure].length}`}><span class="sr-only">{copy.notPaid}: </span>{figure}<span aria-hidden="true" class="number-stop"></span></p>
        <figcaption class="number-caption">
          <p class="cartiglio">{copy.pricesRead(formatDate(read, locale))}</p>
          <p>{copy.numberLabel(names, priced.length)} <strong class="font-[var(--text-headline--font-weight)]">{copy.withSbu(zero)}</strong></p>
          <p class="text-footnote text-ink-muted">{copy.owners}</p>
        </figcaption>
      </figure>
    </section>
  )}

  <section aria-labelledby="promises" class="section">
    <h2 id="promises" class="section-title font-display">{copy.promises}</h2>
    <ul class="promises font-display">
      {t.promises.map((promise) => <li>{promise}</li>)}
    </ul>
    <p class="text-ink-muted">{copy.promisesClose} <a href={localePath(locale, 'principi')} class="underline">{copy.principles}</a></p>
  </section>

  <section aria-labelledby="tools" class="section">
    <h2 id="tools" class="section-title font-display">{copy.tools}</h2>
    <ul class="tools">
      {tools.map((tool) => (
        <li class="tool">
          {tool.mark && <span class="engraving" style={`--engraving: url(${tool.mark})`} aria-hidden="true"></span>}
          <h3 class="tile-name font-display"><a href={tool.href} class="tile-link">{tool.title}</a></h3>
          <p class="text-ink-muted">{tool.line}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  // The tapped cell closes, then the full stop flies from it to the app page's title (view transition).
  // The link stays a plain link: nothing waits for the animation, and without script it simply navigates.
  let closing: HTMLElement | undefined;
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-tile-link]')) {
    link.addEventListener('click', () => {
      closing = link.closest<HTMLElement>('.tile') ?? undefined;
      closing?.classList.add('is-closing');
    });
  }
  // Leaving by a view transition: the tapped cell, not the title's square, is the full stop that travels.
  addEventListener('pageswap', (event) => {
    const cell = closing?.querySelector<HTMLElement>('[data-cell]');
    if (!(event as Event & { viewTransition?: unknown }).viewTransition || !cell) return;
    document.querySelector<HTMLElement>('[data-hero-stop]')?.style.setProperty('view-transition-name', 'none');
    cell.style.viewTransitionName = 'full-stop';
  });
  // Back from the app page (back-forward cache): the sheet as it was.
  addEventListener('pageshow', () => {
    closing?.classList.remove('is-closing');
    closing?.querySelector<HTMLElement>('[data-cell]')?.style.removeProperty('view-transition-name');
    document.querySelector<HTMLElement>('[data-hero-stop]')?.style.removeProperty('view-transition-name');
    closing = undefined;
  });
</script>

<style>
  /* Only design tokens. Every height here is a whole number of grid rows, so what follows stays on the grid:
     lines of text are one row (or two, for titles), gaps and paddings are cells. */
  .hero {
    display: grid;
    gap: var(--sbu-grid-cell);
    padding-block: calc(var(--sbu-grid-cell) * 2) calc(var(--sbu-grid-cell) * 3);
  }
  .hero-title {
    font-weight: var(--text-title--font-weight);
    /* Two cells a line at its smallest, up to five on a wide screen. */
    font-size: clamp(calc(var(--sbu-grid-cell) * 2), 9vw, calc(var(--sbu-grid-cell) * 5));
    line-height: 1;
    line-height: round(up, 1em, var(--sbu-grid-cell));
    text-wrap: balance;
  }
  .hero-word { display: inline-block; }
  .hero-lede {
    max-width: 36ch;
    font-size: var(--text-title-2);
    line-height: calc(var(--sbu-grid-cell) * 1.5);
    color: var(--sbu-ink-muted);
  }

  /* Sections: two cells of paper above and below. The rule on top is drawn over a grid line, so it adds no
     height and the rows below stay aligned. */
  .section {
    position: relative;
    display: grid;
    gap: var(--sbu-grid-cell);
    padding-block: calc(var(--sbu-grid-cell) * 2);
    line-height: var(--sbu-grid-cell);
  }
  .section::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: var(--sbu-hairline);
    background: var(--sbu-line);
  }
  .section-title {
    font-size: var(--text-title);
    line-height: calc(var(--sbu-grid-cell) * 2);
    font-weight: var(--text-title--font-weight);
  }
  .section-lede { max-width: 60ch; color: var(--sbu-ink-muted); }

  /* The sheet: tiles ten cells wide with one cell between them, so every tile starts on a vertical line. */
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, calc(var(--sbu-grid-cell) * 10));
    gap: calc(var(--sbu-grid-cell) * 2) var(--sbu-grid-cell);
    margin-top: var(--sbu-grid-cell);
  }
  .tile { position: relative; display: grid; align-content: start; }
  /* The engraving on four by four cells, the app's cell on the fifth column of the last row: the icon's grammar. */
  .tile-art {
    display: grid;
    grid-template-columns: repeat(5, var(--sbu-grid-cell));
    grid-template-rows: repeat(4, var(--sbu-grid-cell));
    margin-bottom: var(--sbu-grid-cell);
  }
  .engraving {
    display: block;
    background: var(--sbu-ink);
    mask: var(--engraving) center / contain no-repeat;
  }
  .tile-art > .engraving { grid-area: 1 / 1 / 5 / 5; }
  .cell { grid-area: 4 / 5; width: var(--sbu-full-stop-hero); height: var(--sbu-full-stop-hero); background: var(--c); }
  /* Not on the App Store yet with a page of its own: the cell waits, empty, in ink-muted. */
  .is-waiting .cell { background: transparent; border: var(--sbu-row-mark-stroke) solid var(--sbu-ink-muted); }
  .is-waiting .engraving { background: var(--sbu-ink-muted); }
  .tile-name {
    font-size: var(--text-title-2);
    line-height: var(--sbu-grid-cell);
    font-weight: var(--text-title--font-weight);
  }
  .tile-line { font-size: var(--text-subheadline); color: var(--sbu-ink-muted); }
  .tile-link { color: inherit; text-decoration: underline transparent calc(var(--sbu-hairline) * 2); text-underline-offset: var(--spacing-1); }
  .tile-link::after { content: ""; position: absolute; inset: 0; }
  .tile-link:focus-visible { outline: none; }
  .tile:has(.tile-link:focus-visible), .tool:has(.tile-link:focus-visible) {
    outline: calc(var(--sbu-hairline) * 2) solid var(--sbu-focus);
    outline-offset: calc(var(--sbu-hairline) * 2);
  }
  .tile:hover .tile-link, .tile:focus-within .tile-link,
  .tool:hover .tile-link, .tool:focus-within .tile-link { text-decoration-color: currentColor; }

  /* Il numero: as wide as the frame. At width 87 a price's widest glyph, a digit, is 0.506 em (measured on
     Design/fonts/BricolageGrotesque-Variable.ttf), so 0.5 em a character plus two cells for the full stop
     always fits on one line; never under two cells, never over twice figure-hero-max. */
  .number { display: grid; gap: var(--sbu-grid-cell); container-type: inline-size; }
  .number-figure {
    font-size: clamp(calc(var(--sbu-grid-cell) * 2), calc((100cqi - var(--sbu-full-stop-hero) * 2) / (var(--chars) * 0.5)), calc(var(--sbu-figure-hero-max) * 2));
    font-weight: var(--text-figure--font-weight);
    line-height: 1;
    line-height: round(up, 1em, var(--sbu-grid-cell));
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* The full stop: one cell, on the baseline, in ink. */
  .number-stop {
    display: inline-block;
    width: var(--sbu-full-stop-hero);
    height: var(--sbu-full-stop-hero);
    margin-inline-start: var(--sbu-mark-gap);
    background: var(--sbu-ink);
  }
  .number-caption { display: grid; gap: 0; max-width: 60ch; }

  /* The promises: six sentences set large, two columns from a tablet up, two rows each. */
  .promises {
    display: grid;
    column-gap: calc(var(--sbu-grid-cell) * 2);
    font-size: clamp(var(--text-title-2), 4vw, var(--text-title));
    line-height: calc(var(--sbu-grid-cell) * 2);
    font-weight: var(--text-title--font-weight);
  }
  @media (min-width: 48rem) {
    .promises { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* The free tools, each led by the engraving of the app it hands you to. */
  .tools { display: grid; gap: calc(var(--sbu-grid-cell) * 2); }
  @media (min-width: 48rem) {
    .tools { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .tool { position: relative; display: grid; justify-items: start; }
  .tool .engraving { width: calc(var(--sbu-grid-cell) * 6); aspect-ratio: 1; margin-bottom: var(--sbu-grid-cell); }

  @media (prefers-reduced-motion: no-preference) {
    /* The title is set word by word, then the full stop rises onto the baseline. One tempo (ADR-0014). */
    .hero-word { animation: set var(--sbu-motion-base) ease-out calc(var(--i) * var(--sbu-motion-short) / 2) both; }
    .hero-lede { animation: set var(--sbu-motion-base) ease-out var(--sbu-motion-base) both; }
    @keyframes set { from { opacity: 0; translate: 0 var(--spacing-4); } }

    /* The tapped cell closes: it shrinks into itself and fills again, on motion-short. */
    .cell { transition: scale var(--sbu-motion-short) ease-out; }
    .tile:hover .cell { scale: .9; }
    .is-closing .cell { animation: close var(--sbu-motion-short) ease-out both; }
    @keyframes close { 50% { scale: .5; } to { scale: 1; } }

    /* Where the browser has scroll timelines, each tile is written in as it enters the screen. */
    @supports (animation-timeline: view()) {
      .tile, .promises > li {
        animation: set linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
    }
  }
  @media (forced-colors: active) {
    .engraving, .number-stop { forced-color-adjust: none; background: CanvasText; }
    .cell { forced-color-adjust: none; background: Highlight; }
    .is-waiting .cell { background: Canvas; border-color: CanvasText; }
  }
</style>
