---
// The level as a free tool in the browser: the phone's motion sensor, nothing sent anywhere.
// Flat on a surface it is a bubble level; stood on an edge it measures the angle off level.
// The page ends where the browser stops: calibration that stays, haptics and offline are in the app.
import PageTitle from '../components/PageTitle.astro';
import Base from '../layouts/Base.astro';
import { localePath, ui } from '../i18n';
import { text, type App } from '../lib/apps';
import { breadcrumbs, faqPage } from '../lib/jsonld';
import type { Route } from '../lib/routes';

type Props = Route & { app: App };
const { locale, path, alternates, app } = Astro.props;
const t = ui[locale];
const listing = text(app, locale);
const copy = {
  it: {
    title: 'Livella online',
    metaTitle: 'Livella online per iPhone, gratis · sbu.dev',
    description: 'Livella a bolla e clinometro nel browser: appoggia il telefono e leggi l’inclinazione al decimo di grado. Gratis, senza app e senza registrazione.',
    lede: 'Appoggia il telefono su un piano e leggi l’inclinazione. Mettilo di taglio su un bordo e diventa un clinometro. Gira nel browser: niente da installare, niente inviato.',
    figureLabel: 'Inclinazione',
    start: 'Attiva il sensore',
    zero: 'Azzera',
    zeroed: 'Azzerata su questa superficie.',
    noSensor: 'Questo dispositivo non ha un sensore di movimento. Apri sbu.dev/livella dal telefono.',
    denied: 'Il browser non dà accesso al sensore. Controlla le impostazioni di Safari e riprova.',
    strings: { flat: 'In piano.', tilted: 'Non in piano.', edgeFlat: 'Bordo a livello.', edgeTilted: 'Bordo inclinato.', flatMode: 'Bolla', edgeMode: 'Clinometro' },
    appTitle: 'Nell’app fa di più',
    appBody: `${listing.name} tiene la calibrazione, vibra quando sei in piano e funziona anche in modalità aereo. Stesse promesse: gratis, nessun account, nessun dato raccolto.`,
    faq: [
      { q: 'Come funziona la livella online?', a: 'La pagina legge l’accelerometro del telefono dal browser. Con il telefono appoggiato a faccia in su misura quanto il piano si discosta dall’orizzontale; in piedi su un bordo misura l’angolo del bordo.' },
      { q: 'Quanto è precisa?', a: 'Dipende dal sensore del tuo telefono, di solito entro qualche decimo di grado. Per una misura migliore appoggialo su una superficie che sai in piano e tocca Azzera.' },
      { q: 'Su iPhone non succede niente.', a: 'Safari chiede il permesso prima di dare il sensore a una pagina. Tocca Attiva il sensore e consenti l’accesso al movimento.' },
      { q: 'La pagina salva o invia qualcosa?', a: 'No. Le letture restano nel browser e spariscono quando chiudi la pagina. Il sito non usa cookie né statistiche.' },
    ],
  },
  en: {
    title: 'Bubble level online',
    metaTitle: 'Bubble level online for iPhone, free · sbu.dev',
    description: 'A bubble level and clinometer in your browser: lay your phone down and read the tilt to a tenth of a degree. Free, no app, no sign-up.',
    lede: 'Lay your phone on a surface and read the tilt. Stand it on an edge and it becomes a clinometer. It runs in your browser: nothing to install, nothing sent.',
    figureLabel: 'Tilt',
    start: 'Turn on the sensor',
    zero: 'Zero',
    zeroed: 'Zeroed on this surface.',
    noSensor: 'This device has no motion sensor. Open sbu.dev/en/livella on your phone.',
    denied: 'The browser does not allow the sensor. Check your Safari settings and try again.',
    strings: { flat: 'Level.', tilted: 'Not level.', edgeFlat: 'Edge level.', edgeTilted: 'Edge tilted.', flatMode: 'Bubble', edgeMode: 'Clinometer' },
    appTitle: 'The app does more',
    appBody: `${listing.name} keeps its calibration, taps when you are level and works in airplane mode too. Same promises: free, no account, no data collected.`,
    faq: [
      { q: 'How does the online level work?', a: 'The page reads your phone’s accelerometer through the browser. Lying face up, it measures how far the surface is from horizontal; standing on an edge, it measures the angle of that edge.' },
      { q: 'How accurate is it?', a: 'It depends on your phone’s sensor, usually within a few tenths of a degree. For a better reading, lay it on a surface you know is level and tap Zero.' },
      { q: 'Nothing happens on my iPhone.', a: 'Safari asks before it gives a page the sensor. Tap Turn on the sensor and allow motion access.' },
      { q: 'Does the page save or send anything?', a: 'No. Readings stay in the browser and are gone when you close the page. The site uses no cookies or analytics.' },
    ],
  },
}[locale];

const site = Astro.site!;
const cta = app.storeUrl ? { href: app.storeUrl, label: t.appStore } : { href: localePath(locale, `apps/${app.slug}`), label: t.backToApp(listing.name) };
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: copy.title,
    url: new URL(localePath(locale, path), site).href,
    description: copy.description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'iOS, Android',
    browserRequirements: 'DeviceMotionEvent',
    inLanguage: locale,
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'EUR' },
  },
  breadcrumbs(site, locale, [['sbu.dev', ''], [copy.title, path]]),
  faqPage(copy.faq),
];
---
<Base locale={locale} path={path} alternates={alternates} title={copy.metaTitle} description={copy.description} image={`/og/${app.slug}.png`} jsonLd={jsonLd}>
  <article class="flex flex-col gap-12 py-8" style={`--c: var(--sbu-${app.accent})`}>
    <header class="flex flex-col gap-4">
      <PageTitle text={copy.title} accent={app.accent} />
      <p class="text-ink-muted">{copy.lede}</p>
    </header>

    <section class="tool" data-level data-locale={locale} data-strings={JSON.stringify(copy.strings)} aria-label={copy.title}>
      <p class="flex flex-col gap-1">
        <span class="text-caption uppercase text-ink-muted" data-mode>{copy.strings.flatMode}</span>
        <span class="figure font-display tabular-nums text-ink" data-degrees>0,0°</span>
        <span class="text-subheadline text-ink-muted">{copy.figureLabel}</span>
      </p>
      <div class="vial" data-vial aria-hidden="true"><span class="bubble" data-bubble></span></div>
      <p class="text-headline" data-status aria-live="polite"></p>
      <p class="flex flex-wrap items-center gap-3">
        <button type="button" class="btn" data-start hidden>{copy.start}</button>
        <button type="button" class="btn is-ghost" data-zero hidden>{copy.zero}</button>
      </p>
      <p class="text-footnote text-ink-muted" data-note data-zeroed={copy.zeroed} data-no-sensor={copy.noSensor} data-denied={copy.denied}></p>
    </section>

    <section aria-labelledby="app-title" class="flex flex-col items-start gap-4 border-y border-line py-8">
      <h2 id="app-title" class="text-title-2">{copy.appTitle}</h2>
      <p>{copy.appBody}</p>
      <a href={cta.href} class="btn">{cta.label}</a>
      {!app.storeUrl && <p class="text-footnote text-ink-muted">{t.comingSoon}</p>}
    </section>

    <section aria-labelledby="faq" class="flex flex-col gap-4">
      <h2 id="faq" class="text-title-2">{t.faq}</h2>
      {copy.faq.map((item) => (
        <div class="flex flex-col gap-1">
          <h3 class="text-headline">{item.q}</h3>
          <p class="text-ink-muted">{item.a}</p>
        </div>
      ))}
    </section>
  </article>
</Base>

<style>
  .tool { display: grid; gap: var(--spacing-6); }
  .figure {
    font-size: clamp(var(--text-stat-hero), 22vw, calc(var(--text-stat-hero) * 2.4));
    font-weight: var(--text-stat-hero--font-weight);
    line-height: 1;
    letter-spacing: var(--text-stat-hero--letter-spacing);
  }

  /* A round vial: two hairline rings, the inner one turns the accent when level. */
  .vial {
    position: relative;
    width: min(100%, calc(var(--spacing-12) * 6));
    aspect-ratio: 1;
    border: calc(var(--sbu-hairline) * 2) solid var(--sbu-line);
    border-radius: var(--radius-pill);
  }
  .vial::before {
    content: "";
    position: absolute;
    inset: 34%;
    border: calc(var(--sbu-hairline) * 2) solid var(--sbu-line);
    border-radius: var(--radius-pill);
    transition: border-color .3s;
  }
  .vial.is-flat::before { border-color: var(--c); }
  .vial.is-edge { opacity: .4; }
  .bubble {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22%;
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    background: var(--sbu-ink-muted);
    transform: translate(-50%, -50%);
    transition: background-color .3s;
  }
  .vial.is-flat .bubble { background: var(--sbu-ink); }

  .btn {
    display: inline-block;
    padding: var(--spacing-3) var(--spacing-6);
    border: var(--sbu-hairline) solid transparent;
    border-radius: var(--radius-lg);
    background: var(--c);
    color: var(--sbu-on-accent);
    font: inherit;
    font-size: var(--text-headline);
    font-weight: var(--text-headline--font-weight);
    text-decoration: none;
    cursor: pointer;
  }
  .btn.is-ghost { background: transparent; border-color: var(--sbu-line); color: var(--sbu-ink); }
</style>

<script>
  type Strings = { flat: string; tilted: string; edgeFlat: string; edgeTilted: string; flatMode: string; edgeMode: string };
  type Vector = { x: number; y: number; z: number };
  type PermissionRequest = { requestPermission?: () => Promise<PermissionState> };

  const root = document.querySelector<HTMLElement>('[data-level]');
  if (root) start(root);

  function start(root: HTMLElement) {
    const strings = JSON.parse(root.dataset.strings ?? '{}') as Strings;
    const number = new Intl.NumberFormat(root.dataset.locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const one = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const degrees = one('[data-degrees]');
    const mode = one('[data-mode]');
    const status = one('[data-status]');
    const vial = one('[data-vial]');
    const bubble = one('[data-bubble]');
    const note = one('[data-note]');
    const startButton = one<HTMLButtonElement>('[data-start]');
    const zeroButton = one<HTMLButtonElement>('[data-zero]');
    const toDegrees = 180 / Math.PI;

    // Gravity, low-passed. Only magnitudes are shown, so the sign conventions that differ
    // between iOS and Android do not matter for the figure.
    let gravity: Vector | null = null;
    // Zero, one per mode: the surface's own gravity when flat, the edge's angle when standing.
    let flatZero: Vector = { x: 0, y: 0, z: 1 };
    let edgeZero = 0;
    // Bubble direction from orientation, which every browser reports the same way.
    let tilt = { beta: 0, gamma: 0 };
    let tiltZero = { beta: 0, gamma: 0 };
    let lastText = '';

    const onMotion = (event: DeviceMotionEvent) => {
      const g = event.accelerationIncludingGravity;
      if (g?.x == null || g.y == null || g.z == null) return;
      const length = Math.hypot(g.x, g.y, g.z) || 1;
      const next = { x: g.x / length, y: g.y / length, z: g.z / length };
      const k = 0.2; // ponytail: plain low-pass; a longer window if readings jitter on some phones.
      gravity = gravity ? { x: gravity.x + (next.x - gravity.x) * k, y: gravity.y + (next.y - gravity.y) * k, z: gravity.z + (next.z - gravity.z) * k } : next;
      note.textContent = note.textContent === note.dataset.noSensor ? '' : note.textContent;
      zeroButton.hidden = false;
    };
    const onOrientation = (event: DeviceOrientationEvent) => {
      if (event.beta == null || event.gamma == null) return;
      tilt = { beta: event.beta, gamma: event.gamma };
    };

    const flat = () => !!gravity && Math.abs(gravity.z) > 0.7;
    // Angle of the edge off level: the screen-plane gravity angle, from the nearest right angle.
    const edgeAngle = (g: Vector) => {
      const a = ((Math.atan2(g.x, g.y) * toDegrees) % 90 + 90) % 90;
      return a > 45 ? a - 90 : a;
    };

    function listen() {
      addEventListener('devicemotion', onMotion);
      addEventListener('deviceorientation', onOrientation);
      // No reading after a moment: a computer, or a browser without the sensor.
      setTimeout(() => {
        if (!gravity) note.textContent = note.dataset.noSensor ?? '';
      }, 1500);
    }

    // iOS asks first, from a tap. Elsewhere the events just arrive, or never do on a computer.
    const motion = (globalThis as { DeviceMotionEvent?: PermissionRequest }).DeviceMotionEvent;
    const orientation = (globalThis as { DeviceOrientationEvent?: PermissionRequest }).DeviceOrientationEvent;
    if (motion?.requestPermission && matchMedia('(pointer: coarse)').matches) {
      startButton.hidden = false;
      startButton.addEventListener('click', () => {
        Promise.all([motion.requestPermission!(), orientation?.requestPermission?.() ?? Promise.resolve('granted')])
          .then(([state]) => {
            if (state !== 'granted') {
              note.textContent = note.dataset.denied ?? '';
              return;
            }
            startButton.hidden = true;
            note.textContent = '';
            listen();
          })
          .catch(() => (note.textContent = note.dataset.denied ?? ''));
      });
    } else {
      listen();
    }

    zeroButton.addEventListener('click', () => {
      if (!gravity) return;
      if (flat()) {
        flatZero = { ...gravity };
        tiltZero = { ...tilt };
      } else {
        edgeZero = edgeAngle(gravity);
      }
      note.textContent = note.dataset.zeroed ?? '';
    });

    function frame() {
      requestAnimationFrame(frame);
      if (!gravity) return;
      let value: number;
      const isFlat = flat();
      if (isFlat) {
        // Angle between gravity now and gravity on the zeroed surface, face up or face down.
        const dot = Math.abs(gravity.x * flatZero.x + gravity.y * flatZero.y + gravity.z * flatZero.z);
        value = Math.acos(Math.min(1, dot)) * toDegrees;
        // The bubble floats to the high side and touches the rim at 10°. It is 22% of the vial,
        // so from the centre to the rim is 177% of its own size.
        const x = Math.max(-1, Math.min(1, -(tilt.gamma - tiltZero.gamma) / 10));
        const y = Math.max(-1, Math.min(1, -(tilt.beta - tiltZero.beta) / 10));
        bubble.style.transform = `translate(${-50 + x * 177}%, ${-50 + y * 177}%)`;
      } else {
        value = Math.abs(edgeAngle(gravity) - edgeZero);
        bubble.style.transform = '';
      }
      const level = value < 0.3;
      degrees.textContent = `${number.format(value)}°`;
      vial.classList.toggle('is-flat', isFlat && level);
      vial.classList.toggle('is-edge', !isFlat);
      mode.textContent = isFlat ? strings.flatMode : strings.edgeMode;
      const text = isFlat ? (level ? strings.flat : strings.tilted) : level ? strings.edgeFlat : strings.edgeTilted;
      if (text !== lastText) status.textContent = lastText = text;
    }
    requestAnimationFrame(frame);
  }
</script>
